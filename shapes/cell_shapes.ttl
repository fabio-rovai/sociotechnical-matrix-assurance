stms:Cell-DEP-B10 a sh:NodeShape ; sh:targetClass stm:EvaluationRecord ; rdfs:label "DEP-B10" ; stm:forCell stmd:cell-DEP-B10 ;
  sh:sparql [ sh:message "Cell DEP-B10 is not fully evidenced: a required evidence field is not present." ;
    sh:select """SELECT DISTINCT $this ?field WHERE { { BIND(<https://gov.tesseract.academy/id/sociotechnical-matrix/field-E21> AS ?field) }
      FILTER NOT EXISTS { $this <https://gov.tesseract.academy/def/sociotechnical-matrix#hasEvidence> ?e . ?e <https://gov.tesseract.academy/def/sociotechnical-matrix#field> ?field ; <https://gov.tesseract.academy/def/sociotechnical-matrix#status> "present" . } }""" ] .

