stmd:study-40567772 a stm:Study ; stm:pmid "40567772" ; dcterms:title "Validation of automated paper screening for esophagectomy systematic review using large language models" ; dcterms:date "2025" ; stm:selectionRoute "sampled" ; stm:pmcid "PMC12190591" ; stm:doi "10.7717/peerj-cs.2822" .
stmd:record-40567772 a stm:EvaluationRecord ; stm:aboutStudy stmd:study-40567772 ; stm:extractedOn "2026-09-11"^^xsd:date ; stm:extractedBy "claude-evidence-extractor" ;
  stm:hasEvidence stmd:evidence-40567772-E01, stmd:evidence-40567772-E02, stmd:evidence-40567772-E03, stmd:evidence-40567772-E04, stmd:evidence-40567772-E05, stmd:evidence-40567772-E06, stmd:evidence-40567772-E07, stmd:evidence-40567772-E08a, stmd:evidence-40567772-E08b, stmd:evidence-40567772-E08c, stmd:evidence-40567772-E09, stmd:evidence-40567772-E10, stmd:evidence-40567772-E11, stmd:evidence-40567772-E12, stmd:evidence-40567772-E13, stmd:evidence-40567772-E14, stmd:evidence-40567772-E15, stmd:evidence-40567772-E16, stmd:evidence-40567772-E17, stmd:evidence-40567772-E18, stmd:evidence-40567772-E19, stmd:evidence-40567772-E20, stmd:evidence-40567772-E21, stmd:evidence-40567772-E22, stmd:evidence-40567772-E23, stmd:evidence-40567772-E24, stmd:evidence-40567772-E25, stmd:evidence-40567772-E26, stmd:evidence-40567772-E27, stmd:evidence-40567772-E28, stmd:evidence-40567772-E29, stmd:evidence-40567772-E30, stmd:evidence-40567772-E31, stmd:evidence-40567772-E32, stmd:evidence-40567772-E33, stmd:evidence-40567772-E34, stmd:evidence-40567772-E35 .
stmd:evidence-40567772-E01 a stm:EvidenceItem ; stm:field stmd:field-E01 ; stm:status "present" ; stm:location "Abstract, Results" ; stm:quote "In the evaluation of perioperative risk factors, the GPT model demonstrated a high recall for included studies at 89%, a positive predictive value of 74%, and a negative predictive value of 84%, with a low false positive rate of 6% and a macro-F1 score of 0.81." .
stmd:evidence-40567772-E02 a stm:EvidenceItem ; stm:field stmd:field-E02 ; stm:status "present" ; stm:location "Abstract, Methods" ; stm:quote "A literature search was run by a trained librarian to identify studies ( n = 1,967) discussing risk factors to esophagectomy complications. The articles underwent title and abstract screening by three independent human reviewers and GPT-4." .
stmd:evidence-40567772-E03 a stm:EvidenceItem ; stm:field stmd:field-E03 ; stm:status "present" ; stm:location "Results, Table 3" ; stm:quote "Human Decision Include Exclude GPT-model decision Include 30.36% ( n = 596) 10.85% ( n = 213) Exclude 10.85% ( n = 213) 48.04% ( n = 945)" .
stmd:evidence-40567772-E04 a stm:EvidenceItem ; stm:field stmd:field-E04 ; stm:status "present" ; stm:location "Discussion, Potential of LLMs in streamlining systematic reviews" ; stm:quote "For the GPT model, both runs for peri and preoperative risk factors were completed for a total of just 60.51 USD (82.79 CAD), resulting in savings in research funding." .
stmd:evidence-40567772-E05 a stm:EvidenceItem ; stm:field stmd:field-E05 ; stm:status "present" ; stm:location "Discussion, Comparison to existing models" ; stm:quote "Given these limitations, LLMs are recommended as supportive tools in the systematic review process, particularly to aid in screening large datasets and resolving reviewer discrepancies rather than as standalone decision-makers." .
stmd:evidence-40567772-E06 a stm:EvidenceItem ; stm:field stmd:field-E06 ; stm:status "partial" ; stm:location "Length and qualitative assessment" ; stm:quote "These errors emphasize the need for human oversight to verify the justifications provided by GPT." .
stmd:evidence-40567772-E07 a stm:EvidenceItem ; stm:field stmd:field-E07 ; stm:status "partial" ; stm:location "Limitations and future studies" ; stm:quote "Human reviewers might still extract relevant insights from articles without stated outcomes, while the AI may rely more on explicit outcome statements to make inclusion or exclusion decisions." .
stmd:evidence-40567772-E08a a stm:EvidenceItem ; stm:field stmd:field-E08a ; stm:status "absent" ; stm:location "not found in full text, supplement or linked code" .
stmd:evidence-40567772-E08b a stm:EvidenceItem ; stm:field stmd:field-E08b ; stm:status "absent" ; stm:location "not found in full text, supplement or linked code" .
stmd:evidence-40567772-E08c a stm:EvidenceItem ; stm:field stmd:field-E08c ; stm:status "absent" ; stm:location "not found in full text, supplement or linked code" .
stmd:evidence-40567772-E09 a stm:EvidenceItem ; stm:field stmd:field-E09 ; stm:status "partial" ; stm:location "Discussion, Comparison to existing models" ; stm:quote "While the LLM achieved accuracy rates of 85.58% and 79.03%, which indicate promising potential, these rates fall short of the 100% accuracy that might be ideal for independent decision-making in systematic reviews ( Hamel et al., 2021 ; Gates, Johnson & Hartling, 2018 )" .
stmd:evidence-40567772-E10 a stm:EvidenceItem ; stm:field stmd:field-E10 ; stm:status "partial" ; stm:location "Length and qualitative assessment" ; stm:quote "Qualitative inspection of the justifications provided by the GPT model was considered useful by the participating title and abstract screening reviewers." .
stmd:evidence-40567772-E11 a stm:EvidenceItem ; stm:field stmd:field-E11 ; stm:status "present" ; stm:location "Length and qualitative assessment" ; stm:quote "Examples included incorrect references to exclusion criteria or the introduction of nonexistent criteria, highlighting the model’s limitations in accurately mapping its decisions to predefined rules." .
stmd:evidence-40567772-E12 a stm:EvidenceItem ; stm:field stmd:field-E12 ; stm:status "partial" ; stm:location "Discussion, Potential of LLMs in streamlining systematic reviews" ; stm:quote "However, caution is warranted as human reviewers, especially experts in the field, can comprehend terminology and apply clinical gestalt when selecting studies. LLMs like GPT may lack this clinical gestalt component, which could impact decision-making regarding study inclusion/exclusion." .
stmd:evidence-40567772-E13 a stm:EvidenceItem ; stm:field stmd:field-E13 ; stm:status "present" ; stm:location "Discussion" ; stm:quote "In the meantime, caution should be advised for the use of LLMs for highly technical systematic reviews." .
stmd:evidence-40567772-E14 a stm:EvidenceItem ; stm:field stmd:field-E14 ; stm:status "present" ; stm:location "Data Availability" ; stm:quote "The code to reproduce the work is available in the Supplemental File ." .
stmd:evidence-40567772-E15 a stm:EvidenceItem ; stm:field stmd:field-E15 ; stm:status "present" ; stm:location "Introduction" ; stm:quote "In fact, recently, Guo et al. (2024) proposed leveraging the OpenAI for systematic review screening and demonstrated promising results, achieving a macro F1 score of 0.60 and a sensitivity of 0.76 for included articles." .
stmd:evidence-40567772-E16 a stm:EvidenceItem ; stm:field stmd:field-E16 ; stm:status "present" ; stm:location "Methods, Multi-level analysis" ; stm:quote "In the analysis, the final inclusion or exclusion decision reached by the three human reviewers was regarded as “the ground truth” or as the true positive and true negative values." .
stmd:evidence-40567772-E17 a stm:EvidenceItem ; stm:field stmd:field-E17 ; stm:status "present" ; stm:location "Methods; Table 1 note" ; stm:quote "The GPT model was employed without additional fine-tuning, using default parameters of temperature = 0.7, max tokens = 2,048, top p = 1.0, frequency penalty = 0, and presence penalty = 0." .
stmd:evidence-40567772-E18 a stm:EvidenceItem ; stm:field stmd:field-E18 ; stm:status "present" ; stm:location "Supplement: Code notebook (peerj-cs-11-2822-s002.ipynb), fetched via https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12190591/supplementaryFiles" ; stm:quote "You are a researcher rigorously screening titles and abstracts of scientific papers for inclusion or exclusion in a review paper. Use the criteria below to inform your decision. Write \"included\" or \"excluded\" to indicate your decision. Explain your reasoning step-by-step." .
stmd:evidence-40567772-E19 a stm:EvidenceItem ; stm:field stmd:field-E19 ; stm:status "absent" ; stm:location "Supplement: Code notebook (peerj-cs-11-2822-s002.ipynb), fetched via https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12190591/supplementaryFiles" .
stmd:evidence-40567772-E20 a stm:EvidenceItem ; stm:field stmd:field-E20 ; stm:status "present" ; stm:location "Methods" ; stm:quote "The screening inclusion and exclusion criteria ( Appendix 2 ) was fed to the Python script which would subsequently be fed to the GPT-4 API." .
stmd:evidence-40567772-E21 a stm:EvidenceItem ; stm:field stmd:field-E21 ; stm:status "absent" ; stm:location "not found in full text, supplement or linked code" .
stmd:evidence-40567772-E22 a stm:EvidenceItem ; stm:field stmd:field-E22 ; stm:status "absent" ; stm:location "not found in full text, supplement or linked code" .
stmd:evidence-40567772-E23 a stm:EvidenceItem ; stm:field stmd:field-E23 ; stm:status "partial" ; stm:location "Length and qualitative assessment" ; stm:quote "However, at times, the rationale provided by the GPT model demonstrated significant shortcomings, such as misinterpreting or misaligning the criteria with its explanations." .
stmd:evidence-40567772-E24 a stm:EvidenceItem ; stm:field stmd:field-E24 ; stm:status "partial" ; stm:location "Introduction" ; stm:quote "This approach enabled us to rigorously evaluate the effectiveness of the GPT-4 model under varied levels of stringency, providing insights into its adaptability and robustness in more challenging conditions." .
stmd:evidence-40567772-E25 a stm:EvidenceItem ; stm:field stmd:field-E25 ; stm:status "present" ; stm:location "Methods" ; stm:quote "The methodology for our systematic review included a comprehensive search of EMBASE, Medline, and the Cochrane Library from inception to February 21, 2023." .
stmd:evidence-40567772-E26 a stm:EvidenceItem ; stm:field stmd:field-E26 ; stm:status "absent" ; stm:location "not found in full text, supplement or linked code" .
stmd:evidence-40567772-E27 a stm:EvidenceItem ; stm:field stmd:field-E27 ; stm:status "partial" ; stm:location "Supplement: Code notebook (peerj-cs-11-2822-s002.ipynb), fetched via https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12190591/supplementaryFiles" ; stm:quote "model='gpt-4-1106-preview'," .
stmd:evidence-40567772-E28 a stm:EvidenceItem ; stm:field stmd:field-E28 ; stm:status "present" ; stm:location "Methods" ; stm:quote "For this investigation, title and abstract screening was conducted by inputting the literature search results into a Python script, created by Guo et al. (2024) , which made automated calls exclusively to the GPT-4 API." .
stmd:evidence-40567772-E29 a stm:EvidenceItem ; stm:field stmd:field-E29 ; stm:status "partial" ; stm:location "Results, Preoperative risk factor analysis" ; stm:quote "In the broader run of the model, focused on identifying articles discussing perioperative risk factors, the LLM included 189 cases that it did not include in the narrower preoperative run, which targeted identifying articles that only mentioned preoperative risk factors." .
stmd:evidence-40567772-E30 a stm:EvidenceItem ; stm:field stmd:field-E30 ; stm:status "present" ; stm:location "Methods" ; stm:quote "At no point was the ChatGPT interface directly used for screening decisions." .
stmd:evidence-40567772-E31 a stm:EvidenceItem ; stm:field stmd:field-E31 ; stm:status "present" ; stm:location "Limitations and future studies" ; stm:quote "This study has some limitations regarding both internal and external validity. For internal validity, while the GPT model demonstrated a high agreement rate with human reviewers, the accuracy of human screening decisions was used as the baseline, which may introduce subjectivity" .
stmd:evidence-40567772-E32 a stm:EvidenceItem ; stm:field stmd:field-E32 ; stm:status "absent" ; stm:location "not found in full text, supplement or linked code" .
stmd:evidence-40567772-E33 a stm:EvidenceItem ; stm:field stmd:field-E33 ; stm:status "absent" ; stm:location "not found in full text, supplement or linked code" .
stmd:evidence-40567772-E34 a stm:EvidenceItem ; stm:field stmd:field-E34 ; stm:status "absent" ; stm:location "not found in full text, supplement or linked code" .
stmd:evidence-40567772-E35 a stm:EvidenceItem ; stm:field stmd:field-E35 ; stm:status "partial" ; stm:location "Results, Perioperative risk factor analysis" ; stm:quote "The cost for the perioperative risk factor analysis was $29.43 USD, and the run time was 21,130.5 s." .

stmd:study-40921065 a stm:Study ; stm:pmid "40921065" ; dcterms:title "Automated Literature Screening for Hepatocellular Carcinoma Treatment Through Integration of 3 Large Language Models: Methodological Study" ; dcterms:date "2025" ; stm:selectionRoute "sampled" ; stm:pmcid "PMC12455167" ; stm:doi "10.2196/76252" .
stmd:record-40921065 a stm:EvaluationRecord ; stm:aboutStudy stmd:study-40921065 ; stm:extractedOn "2026-09-11"^^xsd:date ; stm:extractedBy "claude-evidence-extractor" ;
  stm:hasEvidence stmd:evidence-40921065-E01, stmd:evidence-40921065-E02, stmd:evidence-40921065-E03, stmd:evidence-40921065-E04, stmd:evidence-40921065-E05, stmd:evidence-40921065-E06, stmd:evidence-40921065-E07, stmd:evidence-40921065-E08a, stmd:evidence-40921065-E08b, stmd:evidence-40921065-E08c, stmd:evidence-40921065-E09, stmd:evidence-40921065-E10, stmd:evidence-40921065-E11, stmd:evidence-40921065-E12, stmd:evidence-40921065-E13, stmd:evidence-40921065-E14, stmd:evidence-40921065-E15, stmd:evidence-40921065-E16, stmd:evidence-40921065-E17, stmd:evidence-40921065-E18, stmd:evidence-40921065-E19, stmd:evidence-40921065-E20, stmd:evidence-40921065-E21, stmd:evidence-40921065-E22, stmd:evidence-40921065-E23, stmd:evidence-40921065-E24, stmd:evidence-40921065-E25, stmd:evidence-40921065-E26, stmd:evidence-40921065-E27, stmd:evidence-40921065-E28, stmd:evidence-40921065-E29, stmd:evidence-40921065-E30, stmd:evidence-40921065-E31, stmd:evidence-40921065-E32, stmd:evidence-40921065-E33, stmd:evidence-40921065-E34, stmd:evidence-40921065-E35 .
stmd:evidence-40921065-E01 a stm:EvidenceItem ; stm:field stmd:field-E01 ; stm:status "present" ; stm:location "Abstract, Methods" ; stm:quote "The system was evaluated across 9 reconstructed datasets derived from published HCC meta-analyses, with performance assessed using accuracy, agreement metrics (κ and prevalence-adjusted bias-adjusted κ), recall, precision, F 1 -scores, and computational efficiency parameters" .
stmd:evidence-40921065-E02 a stm:EvidenceItem ; stm:field stmd:field-E02 ; stm:status "present" ; stm:location "Results, Overview of Datasets; Table 2" ; stm:quote "LORC-CH b Laparoscopic versus open resection of hepatocellular carcinoma in patients with cirrhosis: meta-analysis [ 21 ] 11/770 (1.4%) British Journal of Surgery" .
stmd:evidence-40921065-E03 a stm:EvidenceItem ; stm:field stmd:field-E03 ; stm:status "present" ; stm:location "Results, Overview of Datasets; Table 2" ; stm:quote "In each of the meta-analyses included, 9 datasets were created to represent the initial records identified during their search process, as shown in Table 2 . The number of initially identified records in these simulated datasets ranged from 309 to 8733." .
stmd:evidence-40921065-E04 a stm:EvidenceItem ; stm:field stmd:field-E04 ; stm:status "present" ; stm:location "Results, Performance" ; stm:quote "Regarding time costs, 19,674.2 seconds (approximately 5 h and 28 min) were spent analyzing the 9 datasets, with an average of 2186.0 seconds (approximately 36 min; SD 2052.4 seconds) per dataset." .
stmd:evidence-40921065-E05 a stm:EvidenceItem ; stm:field stmd:field-E05 ; stm:status "partial" ; stm:location "Discussion, Principal Findings" ; stm:quote "Nevertheless, it is important to note that hallucinations in LLMs are difficult to avoid, and appropriate human intervention remains crucial [ 47 ]." .
stmd:evidence-40921065-E06 a stm:EvidenceItem ; stm:field stmd:field-E06 ; stm:status "partial" ; stm:location "Methods, Application Design" ; stm:quote "Finally, model C was assigned the role of arbitrator, reanalyzing those entries for which models A and B had provided conflicting decisions and making the final determination along with the supporting reasoning." .
stmd:evidence-40921065-E07 a stm:EvidenceItem ; stm:field stmd:field-E07 ; stm:status "absent" ; stm:location "not found in full text, Multimedia Appendix 1 or the linked repository" .
stmd:evidence-40921065-E08a a stm:EvidenceItem ; stm:field stmd:field-E08a ; stm:status "present" ; stm:location "Methods, Statistical Analysis" ; stm:quote "The accuracy, precision, recall, F 1 -score, κ, and prevalence-adjusted bias-adjusted κ (PABAK) of the analysis results for all datasets were calculated, where precision and recall were calculated separately based on exclusion and inclusion as the final goal." .
stmd:evidence-40921065-E08b a stm:EvidenceItem ; stm:field stmd:field-E08b ; stm:status "present" ; stm:location "Results, Performance; Figure 2" ; stm:quote "Comparative performance of 3 large language model–based analytic systems across 9 benchmark datasets. The metrics include accuracy, precision, recall, F1-score, κ, and prevalence-adjusted bias-adjusted kappa (PABAK)." .
stmd:evidence-40921065-E08c a stm:EvidenceItem ; stm:field stmd:field-E08c ; stm:status "absent" ; stm:location "not found in full text, Multimedia Appendix 1 or the linked repository" .
stmd:evidence-40921065-E09 a stm:EvidenceItem ; stm:field stmd:field-E09 ; stm:status "absent" ; stm:location "not found in full text, Multimedia Appendix 1 or the linked repository" .
stmd:evidence-40921065-E10 a stm:EvidenceItem ; stm:field stmd:field-E10 ; stm:status "absent" ; stm:location "not found in full text, Multimedia Appendix 1 or the linked repository" .
stmd:evidence-40921065-E11 a stm:EvidenceItem ; stm:field stmd:field-E11 ; stm:status "present" ; stm:location "Discussion" ; stm:quote "Crucially, it should not be ignored that our overall precision and F 1 -scores are relatively low, as shown in Figure 2 . We conducted an in-depth analysis of the cases where misidentification occurred." .
stmd:evidence-40921065-E12 a stm:EvidenceItem ; stm:field stmd:field-E12 ; stm:status "partial" ; stm:location "Discussion" ; stm:quote "the Sankey diagram, as shown in Table S6 and Figure S1 in Multimedia Appendix 1 , revealed that data flow across datasets exhibits remarkable consistency, indicating limited divergent perspectives generated by the secondary model" .
stmd:evidence-40921065-E13 a stm:EvidenceItem ; stm:field stmd:field-E13 ; stm:status "present" ; stm:location "Discussion" ; stm:quote "Moreover, our dataset is currently focused on HCC treatment. Although we selected HCC treatment as a complex test case to rigorously evaluate our system, and the workflow is theoretically generalizable, its performance on broader oncology topics or other disease domains remains to be validated." .
stmd:evidence-40921065-E14 a stm:EvidenceItem ; stm:field stmd:field-E14 ; stm:status "present" ; stm:location "Data Availability" ; stm:quote "The source code is openly available on GitHub [ 49 ]." .
stmd:evidence-40921065-E15 a stm:EvidenceItem ; stm:field stmd:field-E15 ; stm:status "present" ; stm:location "Methods, Validation; Table 1" ; stm:quote "After constructing all the datasets, 3 major language models were selected based on considerations of research cost and model performance. These models were Doubao-1.5-pro-32k from ByteDance (model A), DeepSeek-v3 (model B), and DeepSeek-R1-Distill-Qwen-7B (model C)" .
stmd:evidence-40921065-E16 a stm:EvidenceItem ; stm:field stmd:field-E16 ; stm:status "present" ; stm:location "Methods, Statistical Analysis" ; stm:quote "The result tables from each validation set analyzed by the system were compared with the actual final results (excluding entries with missing or empty abstracts from the simulated search) included in their corresponding papers." .
stmd:evidence-40921065-E17 a stm:EvidenceItem ; stm:field stmd:field-E17 ; stm:status "present" ; stm:location "Supplement: Multimedia Appendix 1 (medinform_v13i1e76252_app1.docx), fetched via https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12455167/supplementaryFiles" ; stm:quote "The common configurations were as follows: (1) temperature of 0.3; (2) batch size of 10; (3) maximum tokens of 4096; (4) threads of 8, and (5) timeout of 180 s. The remaining hyperparameters were kept to the platform's default values." .
stmd:evidence-40921065-E18 a stm:EvidenceItem ; stm:field stmd:field-E18 ; stm:status "present" ; stm:location "Supplement: Multimedia Appendix 1 (medinform_v13i1e76252_app1.docx), fetched via https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12455167/supplementaryFiles" ; stm:quote "You are a medical research expert analyzing clinical trial abstracts. Your task is to analyze each article and determine if it matches the PICOS criteria." .
stmd:evidence-40921065-E19 a stm:EvidenceItem ; stm:field stmd:field-E19 ; stm:status "absent" ; stm:location "Supplement: Multimedia Appendix 1 (medinform_v13i1e76252_app1.docx), fetched via https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12455167/supplementaryFiles" .
stmd:evidence-40921065-E20 a stm:EvidenceItem ; stm:field stmd:field-E20 ; stm:status "present" ; stm:location "Methods, Application Design" ; stm:quote "the program preset roles and inserted the population, intervention, comparison, outcome, and study design (PICOS) guidelines for 3 different large models and embedded the literature entries that needed to be analyzed into prompts in batches." .
stmd:evidence-40921065-E21 a stm:EvidenceItem ; stm:field stmd:field-E21 ; stm:status "partial" ; stm:location "Results, Performance" ; stm:quote "When β was set to 2, the weighted average of F-β was 0.45 (range 0.09-0.68). The weighted average of balanced accuracy was 0.93 (range 0.81-0.99)." .
stmd:evidence-40921065-E22 a stm:EvidenceItem ; stm:field stmd:field-E22 ; stm:status "absent" ; stm:location "not found in full text, Multimedia Appendix 1 or the linked repository" .
stmd:evidence-40921065-E23 a stm:EvidenceItem ; stm:field stmd:field-E23 ; stm:status "partial" ; stm:location "Discussion" ; stm:quote "For example, we found that cost-effectiveness analyses derived from RCTs published by other researchers were incorrectly identified as RCTs themselves." .
stmd:evidence-40921065-E24 a stm:EvidenceItem ; stm:field stmd:field-E24 ; stm:status "absent" ; stm:location "not found in full text, Multimedia Appendix 1 or the linked repository" .
stmd:evidence-40921065-E25 a stm:EvidenceItem ; stm:field stmd:field-E25 ; stm:status "present" ; stm:location "Methods, Validation" ; stm:quote "The following inclusion criteria were used: (1) studies published within the past 5 years, (2) meta-analyses of treatment strategies for PLC, (3) studies that reported the search platforms used and described the basic search strategy in the text, and (4) studies published in the top 5% of journals" .
stmd:evidence-40921065-E26 a stm:EvidenceItem ; stm:field stmd:field-E26 ; stm:status "present" ; stm:location "Methods, Validation; Table 1" ; stm:quote "Model A Doubao-1.5-pro-32k Closed; general purpose; MoE a High performance and multimodal capability Closed source model with low transparency" .
stmd:evidence-40921065-E27 a stm:EvidenceItem ; stm:field stmd:field-E27 ; stm:status "partial" ; stm:location "Methods, Validation; Table 1" ; stm:quote "These models were Doubao-1.5-pro-32k from ByteDance (model A), DeepSeek-v3 (model B), and DeepSeek-R1-Distill-Qwen-7B (model C), with model C distinguished as a reasoning-optimized LLM." .
stmd:evidence-40921065-E28 a stm:EvidenceItem ; stm:field stmd:field-E28 ; stm:status "partial" ; stm:location "Methods, Validation" ; stm:quote "To ensure minimal human intervention in the simulation, any studies that were ultimately included in the original meta-analyses but were missing from the search results were not added back to the datasets." .
stmd:evidence-40921065-E29 a stm:EvidenceItem ; stm:field stmd:field-E29 ; stm:status "present" ; stm:location "Discussion" ; stm:quote "We conducted an in-depth analysis of the cases where misidentification occurred. First, nonspecialized models and potentially insufficient training corpora may be responsible for the initial misclassification of literature entries" .
stmd:evidence-40921065-E30 a stm:EvidenceItem ; stm:field stmd:field-E30 ; stm:status "present" ; stm:location "Discussion, Principal Findings" ; stm:quote "Furthermore, our system leverages a program that sends local requests to the LLM’s cloud computing service, resulting in minimal requirements for user-side devices. It does not necessitate high-performance GPUs, and only terminal devices capable of multithreading are required" .
stmd:evidence-40921065-E31 a stm:EvidenceItem ; stm:field stmd:field-E31 ; stm:status "present" ; stm:location "Discussion" ; stm:quote "Our system has certain limitations. Although our datasets encompass multiple topics with substantial numbers of records initially identified, the Sankey diagram, as shown in Table S6 and Figure S1 in Multimedia Appendix 1 , revealed that data flow across datasets exhibits remarkable consistency" .
stmd:evidence-40921065-E32 a stm:EvidenceItem ; stm:field stmd:field-E32 ; stm:status "present" ; stm:location "Results, Performance" ; stm:quote "In contrast, when targeting inclusion, the weighted average precision was 0.15 (SD 0.13; range 0.05-0.47), while the weighted recall was 0.90 (SD 0.16; range 0.62-1.00)." .
stmd:evidence-40921065-E33 a stm:EvidenceItem ; stm:field stmd:field-E33 ; stm:status "absent" ; stm:location "not found in full text, Multimedia Appendix 1 or the linked repository" .
stmd:evidence-40921065-E34 a stm:EvidenceItem ; stm:field stmd:field-E34 ; stm:status "partial" ; stm:location "Results, Performance" ; stm:quote "Overall, the system correctly classified 26,735 (95.54%) of 27,982 records across the 9 datasets. When targeting exclusion, the weighted average precision and recall reached approximately 1.00 (SD < 0.01; range 0.99-1.00) and 0.96 (SD 0.04; range 0.90-1.00), respectively." .
stmd:evidence-40921065-E35 a stm:EvidenceItem ; stm:field stmd:field-E35 ; stm:status "partial" ; stm:location "Results, Performance" ; stm:quote "Furthermore, the economic costs were modest, with the analysis of all datasets totaling US $11.59, an average of US $1.29 (SD US $1.25) per dataset, and approximately US $0.41 per 1000 entries." .

stmd:study-41023870 a stm:Study ; stm:pmid "41023870" ; dcterms:title "A human-LLM collaborative annotation approach for screening articles on precision oncology randomized controlled trials" ; dcterms:date "2025" ; stm:selectionRoute "sampled" ; stm:pmcid "PMC12481989" ; stm:doi "10.1186/s12874-025-02674-3" .
stmd:record-41023870 a stm:EvaluationRecord ; stm:aboutStudy stmd:study-41023870 ; stm:extractedOn "2026-09-11"^^xsd:date ; stm:extractedBy "claude-evidence-extractor" ;
  stm:hasEvidence stmd:evidence-41023870-E01, stmd:evidence-41023870-E02, stmd:evidence-41023870-E03, stmd:evidence-41023870-E04, stmd:evidence-41023870-E05, stmd:evidence-41023870-E06, stmd:evidence-41023870-E07, stmd:evidence-41023870-E08a, stmd:evidence-41023870-E08b, stmd:evidence-41023870-E08c, stmd:evidence-41023870-E09, stmd:evidence-41023870-E10, stmd:evidence-41023870-E11, stmd:evidence-41023870-E12, stmd:evidence-41023870-E13, stmd:evidence-41023870-E14, stmd:evidence-41023870-E15, stmd:evidence-41023870-E16, stmd:evidence-41023870-E17, stmd:evidence-41023870-E18, stmd:evidence-41023870-E19, stmd:evidence-41023870-E20, stmd:evidence-41023870-E21, stmd:evidence-41023870-E22, stmd:evidence-41023870-E23, stmd:evidence-41023870-E24, stmd:evidence-41023870-E25, stmd:evidence-41023870-E26, stmd:evidence-41023870-E27, stmd:evidence-41023870-E28, stmd:evidence-41023870-E29, stmd:evidence-41023870-E30, stmd:evidence-41023870-E31, stmd:evidence-41023870-E32, stmd:evidence-41023870-E33, stmd:evidence-41023870-E34, stmd:evidence-41023870-E35 .
stmd:evidence-41023870-E01 a stm:EvidenceItem ; stm:field stmd:field-E01 ; stm:status "present" ; stm:location "Abstract, Results" ; stm:quote "The results showed that the collaborative annotation achieved an F1 score of 0.9583, reducing the annotation workload by approximately 80% compared to manual annotation alone." .
stmd:evidence-41023870-E02 a stm:EvidenceItem ; stm:field stmd:field-E02 ; stm:status "present" ; stm:location "Methods, Data source and screening criteria" ; stm:quote "we retrieved articles from PubMed [ 17 ] using the search query: “randomized controlled trial”[pt] AND “cancer”[MeSH Major Topic] AND “humans”[mh]. This search yielded 23,521 articles published between January 1, 2012, and December 31, 2023." .
stmd:evidence-41023870-E03 a stm:EvidenceItem ; stm:field stmd:field-E03 ; stm:status "present" ; stm:location "Results, Result of prompt optimization" ; stm:quote "As shown in Fig. 3 , we ultimately identified 13 precision oncology clinical trial articles." .
stmd:evidence-41023870-E04 a stm:EvidenceItem ; stm:field stmd:field-E04 ; stm:status "present" ; stm:location "Results, Performance of human-LLM collaborative annotation" ; stm:quote "there are only 274 positive labels by the LLM for 1800 articles, which suggests that the pre-annotation of the LLM significantly reduces the number of articles that need to be manually annotated, decreasing the need for manual annotation by about 80% (1-274/1800)" .
stmd:evidence-41023870-E05 a stm:EvidenceItem ; stm:field stmd:field-E05 ; stm:status "present" ; stm:location "Discussion, Selection of article screening methods" ; stm:quote "Specifically, the LLM can perform the initial screening, with human correction to enhance both efficiency and accuracy." .
stmd:evidence-41023870-E06 a stm:EvidenceItem ; stm:field stmd:field-E06 ; stm:status "present" ; stm:location "Methods, Collaborative annotation" ; stm:quote "Although errors may occur among the LLM-annotated positive samples, they are relatively rare. By selectively verifying these positive samples manually, we can effectively correct any misclassifications." .
stmd:evidence-41023870-E07 a stm:EvidenceItem ; stm:field stmd:field-E07 ; stm:status "absent" ; stm:location "not found in full text or the linked repository" .
stmd:evidence-41023870-E08a a stm:EvidenceItem ; stm:field stmd:field-E08a ; stm:status "absent" ; stm:location "not found in full text or the linked repository" .
stmd:evidence-41023870-E08b a stm:EvidenceItem ; stm:field stmd:field-E08b ; stm:status "absent" ; stm:location "not found in full text or the linked repository" .
stmd:evidence-41023870-E08c a stm:EvidenceItem ; stm:field stmd:field-E08c ; stm:status "absent" ; stm:location "not found in full text or the linked repository" .
stmd:evidence-41023870-E09 a stm:EvidenceItem ; stm:field stmd:field-E09 ; stm:status "partial" ; stm:location "Results, Supervised model performance across different annotation strategies" ; stm:quote "To prioritize higher recall, we selected models for testing that achieved a recall above 0.8 while maximizing the F1 score on the validation set." .
stmd:evidence-41023870-E10 a stm:EvidenceItem ; stm:field stmd:field-E10 ; stm:status "absent" ; stm:location "not found in full text or the linked repository" .
stmd:evidence-41023870-E11 a stm:EvidenceItem ; stm:field stmd:field-E11 ; stm:status "present" ; stm:location "Discussion, Limitations and future work" ; stm:quote "Without these characteristics, the collaborative annotation method may result in a low recall rate, potentially omitting relevant literature." .
stmd:evidence-41023870-E12 a stm:EvidenceItem ; stm:field stmd:field-E12 ; stm:status "partial" ; stm:location "Discussion, Limitations and future work" ; stm:quote "We do not manually verify the negative annotations made by the LLM, and therefore cannot correct for false-positive samples. Therefore, the LLM must demonstrate high recall and strong generalization capabilities." .
stmd:evidence-41023870-E13 a stm:EvidenceItem ; stm:field stmd:field-E13 ; stm:status "present" ; stm:location "Methods, Collaborative annotation" ; stm:quote "It is important to emphasize that our collaborative annotation approach is specifically designed for tasks involving article screening with a low prevalence of positive samples, where articles meeting specific criteria comprise only a small fraction of the retrieved set." .
stmd:evidence-41023870-E14 a stm:EvidenceItem ; stm:field stmd:field-E14 ; stm:status "present" ; stm:location "Data availability" ; stm:quote "Our dataset is available on GitHub, via https://github.com/Hui-zju/porct_as/tree/main/data ." .
stmd:evidence-41023870-E15 a stm:EvidenceItem ; stm:field stmd:field-E15 ; stm:status "partial" ; stm:location "Methods, Fine-tuning of the supervised model" ; stm:quote "We selected the BioBERT [ 19 ] model, known for its excellent performance in previous studies [ 6 , 20 ], for fine-tuning to perform the classification task." .
stmd:evidence-41023870-E16 a stm:EvidenceItem ; stm:field stmd:field-E16 ; stm:status "present" ; stm:location "Methods, Data source and screening criteria" ; stm:quote "To ensure accuracy and reliability, two experts conducted the initial annotations independently. Any discrepancies were reviewed by an additional annotator who made the final decision. We used the Medtator [ 18 ] annotation tool for this process." .
stmd:evidence-41023870-E17 a stm:EvidenceItem ; stm:field stmd:field-E17 ; stm:status "present" ; stm:location "Methods, Design of ChatGPT prompt" ; stm:quote "we configured the top-p parameter to its default value of 1, while setting the temperature to 0. This configuration minimizes the variability of the returned responses." .
stmd:evidence-41023870-E18 a stm:EvidenceItem ; stm:field stmd:field-E18 ; stm:status "present" ; stm:location "Repository: https://github.com/Hui-zju/porct_as/blob/main/prompt_optimization/norms.py" ; stm:quote "system_task = \"As an expert annotator with a focus on scientific article content analysis, your role involves ascertaining whether the article meets the criteria.\"" .
stmd:evidence-41023870-E19 a stm:EvidenceItem ; stm:field stmd:field-E19 ; stm:status "absent" ; stm:location "Repository: https://github.com/Hui-zju/porct_as/blob/main/prompt_optimization/norms.py" .
stmd:evidence-41023870-E20 a stm:EvidenceItem ; stm:field stmd:field-E20 ; stm:status "present" ; stm:location "Methods, Data source and screening criteria" ; stm:quote "we established four criteria as shown in Table 1 : (1) the article must be a randomized controlled trial, (2) the study population must be cancer patients, (3) the study purpose must be cancer treatment evaluation, and (4)the study must involve biomarkers related to genetic and molecular" .
stmd:evidence-41023870-E21 a stm:EvidenceItem ; stm:field stmd:field-E21 ; stm:status "present" ; stm:location "Abstract, Methods" ; stm:quote "Initially, we optimized the prompt using a manually annotated standard dataset, refining it iteratively to achieve near-perfect recall for the LLM." .
stmd:evidence-41023870-E22 a stm:EvidenceItem ; stm:field stmd:field-E22 ; stm:status "absent" ; stm:location "not found in full text or the linked repository" .
stmd:evidence-41023870-E23 a stm:EvidenceItem ; stm:field stmd:field-E23 ; stm:status "partial" ; stm:location "Background" ; stm:quote "The potential for biased labels due to biased training data [ 12 ], as well as the difficulty in understanding the nuances of natural language in different contexts [ 13 ], leads to considerable variation in performance across different tasks, datasets, and labels." .
stmd:evidence-41023870-E24 a stm:EvidenceItem ; stm:field stmd:field-E24 ; stm:status "present" ; stm:location "Results, Result of prompt optimization" ; stm:quote "The optimization of LLM prompts is an iterative process, and the model’s performance does not always improve with each modification. It varies with different combinations of prompt optimization methods, making it challenging to present the iterative optimization process intuitively." .
stmd:evidence-41023870-E25 a stm:EvidenceItem ; stm:field stmd:field-E25 ; stm:status "present" ; stm:location "Methods, Data source and screening criteria" ; stm:quote "During the manual annotation process, experts assessed whether each article met these criteria based on the title and abstract. To ensure accuracy and reliability, two experts conducted the initial annotations independently." .
stmd:evidence-41023870-E26 a stm:EvidenceItem ; stm:field stmd:field-E26 ; stm:status "partial" ; stm:location "Discussion, Limitations and future work" ; stm:quote "Therefore, to ensure reproducibility of the study, the recommended best practice is to employ an open source LLM based on publicly available training data." .
stmd:evidence-41023870-E27 a stm:EvidenceItem ; stm:field stmd:field-E27 ; stm:status "partial" ; stm:location "Methods, Design of ChatGPT prompt" ; stm:quote "Using the OpenAI API ( https://platform.openai.com/docs/api-reference ), we selected “gpt-3.5-turbo” as our base model." .
stmd:evidence-41023870-E28 a stm:EvidenceItem ; stm:field stmd:field-E28 ; stm:status "partial" ; stm:location "Results, Performance of human-LLM collaborative annotation" ; stm:quote "To assess the accuracy of Human-LLM collaborative annotation,we randomly selected 300 articles from the collaboratively annotated dataset for manual review on an article-by-article basis to produce gold standard labels." .
stmd:evidence-41023870-E29 a stm:EvidenceItem ; stm:field stmd:field-E29 ; stm:status "present" ; stm:location "Results, Performance of human-LLM collaborative annotation" ; stm:quote "Compared to LLM-only annotation, human-LLM annotation improves annotation performance primarily by reducing the number of false positives through manual review (28 vs 0)." .
stmd:evidence-41023870-E30 a stm:EvidenceItem ; stm:field stmd:field-E30 ; stm:status "present" ; stm:location "Methods, Design of ChatGPT prompt" ; stm:quote "We utilized the role attribute in the message objects to define the prompts for “system” and “user” roles. The “system” role was employed to set the context and guidelines, providing ChatGPT’s virtual character and relevant background information." .
stmd:evidence-41023870-E31 a stm:EvidenceItem ; stm:field stmd:field-E31 ; stm:status "present" ; stm:location "Discussion, Limitations and future work" ; stm:quote "The proposed human-LLM collaborative annotation method relies on the assumption that relevant articles constitute a small proportion of the search results. If this assumption is not met, the effectiveness of the method may be compromised." .
stmd:evidence-41023870-E32 a stm:EvidenceItem ; stm:field stmd:field-E32 ; stm:status "partial" ; stm:location "Discussion, Limitations and future work" ; stm:quote "The difference in recall between the tuning set (100%) and the validation set (86%) during prompt optimization indicates potential overfitting." .
stmd:evidence-41023870-E33 a stm:EvidenceItem ; stm:field stmd:field-E33 ; stm:status "partial" ; stm:location "Background" ; stm:quote "we hypothesize that if we could develop a model with near-perfect recall and high precision, then the negative samples annotated by the LLM would mostly be correct." .
stmd:evidence-41023870-E34 a stm:EvidenceItem ; stm:field stmd:field-E34 ; stm:status "absent" ; stm:location "not found in full text or the linked repository" .
stmd:evidence-41023870-E35 a stm:EvidenceItem ; stm:field stmd:field-E35 ; stm:status "absent" ; stm:location "not found in full text or the linked repository" .

stmd:study-41326830 a stm:Study ; stm:pmid "41326830" ; dcterms:title "Evaluating the Efficacy and Efficiency of GPT-5 for Automated Title and Abstract Screening in Orthopedic Surgery Systematic Reviews" ; dcterms:date "2025" ; stm:selectionRoute "sampled" ; stm:pmcid "PMC12669451" ; stm:doi "10.1007/s12178-025-10001-y" .
stmd:record-41326830 a stm:EvaluationRecord ; stm:aboutStudy stmd:study-41326830 ; stm:extractedOn "2026-09-11"^^xsd:date ; stm:extractedBy "claude-code-evidence-extractor" ;
  stm:hasEvidence stmd:evidence-41326830-E01, stmd:evidence-41326830-E02, stmd:evidence-41326830-E03, stmd:evidence-41326830-E04, stmd:evidence-41326830-E05, stmd:evidence-41326830-E06, stmd:evidence-41326830-E07, stmd:evidence-41326830-E08a, stmd:evidence-41326830-E08b, stmd:evidence-41326830-E08c, stmd:evidence-41326830-E09, stmd:evidence-41326830-E10, stmd:evidence-41326830-E11, stmd:evidence-41326830-E12, stmd:evidence-41326830-E13, stmd:evidence-41326830-E14, stmd:evidence-41326830-E15, stmd:evidence-41326830-E16, stmd:evidence-41326830-E17, stmd:evidence-41326830-E18, stmd:evidence-41326830-E19, stmd:evidence-41326830-E20, stmd:evidence-41326830-E21, stmd:evidence-41326830-E22, stmd:evidence-41326830-E23, stmd:evidence-41326830-E24, stmd:evidence-41326830-E25, stmd:evidence-41326830-E26, stmd:evidence-41326830-E27, stmd:evidence-41326830-E28, stmd:evidence-41326830-E29, stmd:evidence-41326830-E30, stmd:evidence-41326830-E31, stmd:evidence-41326830-E32, stmd:evidence-41326830-E33, stmd:evidence-41326830-E34, stmd:evidence-41326830-E35 .
stmd:evidence-41326830-E01 a stm:EvidenceItem ; stm:field stmd:field-E01 ; stm:status "present" ; stm:location "Methods, Model Performance" ; stm:quote "Performance was evaluated with negative predictive value (NPV), positive predictive value (PPV), sensitivity, specificity, accuracy, and F1 score based on true positives (TP), false positives (FP), true negatives (TN), and false negative (FN)." .
stmd:evidence-41326830-E02 a stm:EvidenceItem ; stm:field stmd:field-E02 ; stm:status "present" ; stm:location "Results, Objective 2: Identifying Specific Study Designs (Trauma)" ; stm:quote "After final adjudication by the third human reviewer, which served as the gold standard for inclusion and exclusion decisions, 17 abstracts met the inclusion criteria and 1,024 were excluded." .
stmd:evidence-41326830-E03 a stm:EvidenceItem ; stm:field stmd:field-E03 ; stm:status "present" ; stm:location "Methods, Objective 2: Identifying Specific Study Designs (Trauma)" ; stm:quote "The second objective was to have GPT-5 and human reviewers identify randomized controlled trials (RCTs) comparing operative and nonoperative management of mid-shaft clavicle fractures. PubMed was queried on July 12, 2025, yielding 1,041 total results." .
stmd:evidence-41326830-E04 a stm:EvidenceItem ; stm:field stmd:field-E04 ; stm:status "present" ; stm:location "Results, Objective 1: Identifying a Niche Patient Population (Sports Medicine)" ; stm:quote "The total cost to screen all 668 abstracts was $1.32USD ($0.0020USD/abstract), and the task was completed in 38.5 min (17.4 abstracts/minute)" .
stmd:evidence-41326830-E05 a stm:EvidenceItem ; stm:field stmd:field-E05 ; stm:status "partial" ; stm:location "Discussion" ; stm:quote "performance metrics that are consistently above 90%, specifically for sensitivity and specificity suggest readiness for transition to AI-based screening without human validation" .
stmd:evidence-41326830-E06 a stm:EvidenceItem ; stm:field stmd:field-E06 ; stm:status "partial" ; stm:location "Methods, Gold-Standard Inclusion and Exclusion Decisions" ; stm:quote "All conflicts between human reviewers and all discrepancies between the LLM and humans were adjudicated by the third reviewer." .
stmd:evidence-41326830-E07 a stm:EvidenceItem ; stm:field stmd:field-E07 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41326830-E08a a stm:EvidenceItem ; stm:field stmd:field-E08a ; stm:status "present" ; stm:location "Methods, Study Design and Overview" ; stm:quote "To increase generalizability, each objective and evaluation was within a distinct orthopedic subspecialty (sports medicine, trauma, and arthroplasty)." .
stmd:evidence-41326830-E08b a stm:EvidenceItem ; stm:field stmd:field-E08b ; stm:status "present" ; stm:location "Results, Objective 1; Table 3, GPT-5 performance metrics" ; stm:quote "This corresponded to a sensitivity of 100%, specificity of 99.7%, PPV of 92.3%, NPV of 100%, accuracy of 99.7%, and F1 score of 95.9%." .
stmd:evidence-41326830-E08c a stm:EvidenceItem ; stm:field stmd:field-E08c ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41326830-E09 a stm:EvidenceItem ; stm:field stmd:field-E09 ; stm:status "partial" ; stm:location "Discussion" ; stm:quote "While there aren’t established benchmarks for understanding what entails strong AI performance, performance metrics that are consistently above 90%, specifically for sensitivity and specificity suggest readiness for transition to AI-based screening without human validation." .
stmd:evidence-41326830-E10 a stm:EvidenceItem ; stm:field stmd:field-E10 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41326830-E11 a stm:EvidenceItem ; stm:field stmd:field-E11 ; stm:status "present" ; stm:location "Discussion, limitations" ; stm:quote "Finally, while the number of FNs were low, it is unclear what led to GPT-5 wrongly excluding certains ones." .
stmd:evidence-41326830-E12 a stm:EvidenceItem ; stm:field stmd:field-E12 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41326830-E13 a stm:EvidenceItem ; stm:field stmd:field-E13 ; stm:status "present" ; stm:location "Discussion; Appendix Table 4, Author's recommendations" ; stm:quote "Given these results, it is possible that systematic review title and abstract screening can be done with LLMs, when used via APIs in a controlled setting, with the aim of minimizing hallucinations." .
stmd:evidence-41326830-E14 a stm:EvidenceItem ; stm:field stmd:field-E14 ; stm:status "partial" ; stm:location "Discussion; Table 2, System prompts provided to GPT-5; Data Availability" ; stm:quote "However, this study has disclosed the full prompts for each screening task that resulted in strong performance," .
stmd:evidence-41326830-E15 a stm:EvidenceItem ; stm:field stmd:field-E15 ; stm:status "present" ; stm:location "Introduction" ; stm:quote "GPT-4 was a common high performer amongst LLMs within these studies, yielding the highest levels of accuracy and sensitivity [7]." .
stmd:evidence-41326830-E16 a stm:EvidenceItem ; stm:field stmd:field-E16 ; stm:status "present" ; stm:location "Methods, Human Review Process; Methods, Gold-Standard Inclusion and Exclusion Decisions" ; stm:quote "Two human reviewers independently screened each title and abstract for eligibility based on the previously outlined inclusion and exclusion criteria on Covidence online software (Veritas Health Innovation, Melbourne, Australia)." .
stmd:evidence-41326830-E17 a stm:EvidenceItem ; stm:field stmd:field-E17 ; stm:status "partial" ; stm:location "Table 2, System prompts provided to GPT-5" ; stm:quote "OUTPUT INSTRUCTIONS: Respond with EXACTLY one word: YES (if included) or NO (excluded)" .
stmd:evidence-41326830-E18 a stm:EvidenceItem ; stm:field stmd:field-E18 ; stm:status "present" ; stm:location "Table 2, System prompts provided to GPT-5" ; stm:quote "Based on the abstract below, respond with a one-word decision: **YES** if all inclusion criteria are met, **NO** if not." .
stmd:evidence-41326830-E19 a stm:EvidenceItem ; stm:field stmd:field-E19 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41326830-E20 a stm:EvidenceItem ; stm:field stmd:field-E20 ; stm:status "present" ; stm:location "Methods, Objective 1: Identifying a Niche Patient Population (Sports Medicine)" ; stm:quote "Inclusion criteria were: 1. Patients undergoing revision ACLR. 2. Patients receiving a quadriceps tendon autograft." .
stmd:evidence-41326830-E21 a stm:EvidenceItem ; stm:field stmd:field-E21 ; stm:status "partial" ; stm:location "Appendix Table 4, Author's recommendations" ; stm:quote "Optimize for sensitivity, would prefer to minimize false negatives (missing studies) as opposed to minimizing false positives" .
stmd:evidence-41326830-E22 a stm:EvidenceItem ; stm:field stmd:field-E22 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41326830-E23 a stm:EvidenceItem ; stm:field stmd:field-E23 ; stm:status "partial" ; stm:location "Discussion" ; stm:quote "when used via APIs in a controlled setting, with the aim of minimizing hallucinations" .
stmd:evidence-41326830-E24 a stm:EvidenceItem ; stm:field stmd:field-E24 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41326830-E25 a stm:EvidenceItem ; stm:field stmd:field-E25 ; stm:status "present" ; stm:location "Methods, Data Sources and Abstract Sets; Table 1, PubMed search strategies" ; stm:quote "Abstracts for each task were retrieved from comprehensive literature searches using PubMed. Alternative databases weren’t used as the focus of the study was to evaluate the ability of LLMs to correctly include and exclude titles/abstracts in comparison with humans" .
stmd:evidence-41326830-E26 a stm:EvidenceItem ; stm:field stmd:field-E26 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41326830-E27 a stm:EvidenceItem ; stm:field stmd:field-E27 ; stm:status "partial" ; stm:location "Methods, GPT-5 Screening" ; stm:quote "A Python-based NLP script was developed by the primary author to screen titles and abstracts using GPT-5 (OpenAI, San Francisco, California) via the OpenAI Application Programming Interface (API)." .
stmd:evidence-41326830-E28 a stm:EvidenceItem ; stm:field stmd:field-E28 ; stm:status "partial" ; stm:location "Methods, Data Sources and Abstract Sets; Results" ; stm:quote "Alternative databases weren’t used as the focus of the study was to evaluate the ability of LLMs to correctly include and exclude titles/abstracts in comparison with humans as opposed to truly simulating the systematic review process." .
stmd:evidence-41326830-E29 a stm:EvidenceItem ; stm:field stmd:field-E29 ; stm:status "present" ; stm:location "Results, Objective 1; Results, Objective 2; Results, Objective 3" ; stm:quote "The single abstract excluded by GPT-5 was incorrectly included by reviewers as it described revision ACLR with quadriceps tendon autografts, but only reported on practice trends without clinical outcomes." .
stmd:evidence-41326830-E30 a stm:EvidenceItem ; stm:field stmd:field-E30 ; stm:status "present" ; stm:location "Methods, Pre-Processing of Abstracts; Methods, GPT-5 Screening; Methods, Efficiency Outcomes" ; stm:quote "For each topic, database exports from PubMed searches described above were downloaded and parsed using a custom Python script." .
stmd:evidence-41326830-E31 a stm:EvidenceItem ; stm:field stmd:field-E31 ; stm:status "present" ; stm:location "Discussion, limitations" ; stm:quote "There are few limitations from this analysis. First, the study focused exclusively on orthopedic topics and PubMed-derived abstracts." .
stmd:evidence-41326830-E32 a stm:EvidenceItem ; stm:field stmd:field-E32 ; stm:status "partial" ; stm:location "Results, Objective 2; Discussion, limitations" ; stm:quote "However, one study was incorrectly excluded by GPT-5, despite the abstract clearly stating that it was an RCT comparing plate osteosynthesis with figure-of-eight bracing." .
stmd:evidence-41326830-E33 a stm:EvidenceItem ; stm:field stmd:field-E33 ; stm:status "absent" ; stm:location "not found" .
