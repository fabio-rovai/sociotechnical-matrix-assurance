stmd:evidence-41626916-E25 a stm:EvidenceItem ; stm:field stmd:field-E25 ; stm:status "present" ; stm:location "Methods, 2 Methods; Supplementary Material 1; Results, 3" ; stm:quote "Potentially eligible articles ( n = 1,397) were identified through searches conducted in the Medline, Embase, and Scopus databases in October 2022." .
stmd:evidence-41626916-E26 a stm:EvidenceItem ; stm:field stmd:field-E26 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41626916-E27 a stm:EvidenceItem ; stm:field stmd:field-E27 ; stm:status "partial" ; stm:location "Methods, 2 Methods; Methods, 2.1 Llama 3; Methods, 2.2 ChatGPT-4o mini" ; stm:quote "The AI tools were employed in July 2024." .
