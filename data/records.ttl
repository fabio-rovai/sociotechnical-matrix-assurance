stmd:evidence-41326830-E35 a stm:EvidenceItem ; stm:field stmd:field-E35 ; stm:status "partial" ; stm:location "Methods, Efficiency Outcomes; Results; Table 3" ; stm:quote "To assess efficiency and feasibility, runtime and API usage cost were tracked." .

stmd:study-41422008 a stm:Study ; stm:pmid "41422008" ; dcterms:title "Harnessing ChatGPT for abstract screening in health-related scoping reviews: the role of structured eligibility criteria" ; dcterms:date "2025" ; stm:selectionRoute "sampled" ; stm:pmcid "PMC12831233" ; stm:doi "10.1186/s12913-025-13901-4" .
stmd:record-41422008 a stm:EvaluationRecord ; stm:aboutStudy stmd:study-41422008 ; stm:extractedOn "2026-09-11"^^xsd:date ; stm:extractedBy "claude-code-evidence-extractor" ;
  stm:hasEvidence stmd:evidence-41422008-E01, stmd:evidence-41422008-E02, stmd:evidence-41422008-E03, stmd:evidence-41422008-E04, stmd:evidence-41422008-E05, stmd:evidence-41422008-E06, stmd:evidence-41422008-E07, stmd:evidence-41422008-E08a, stmd:evidence-41422008-E08b, stmd:evidence-41422008-E08c, stmd:evidence-41422008-E09, stmd:evidence-41422008-E10, stmd:evidence-41422008-E11, stmd:evidence-41422008-E12, stmd:evidence-41422008-E13, stmd:evidence-41422008-E14, stmd:evidence-41422008-E15, stmd:evidence-41422008-E16, stmd:evidence-41422008-E17, stmd:evidence-41422008-E18, stmd:evidence-41422008-E19, stmd:evidence-41422008-E20, stmd:evidence-41422008-E21, stmd:evidence-41422008-E22, stmd:evidence-41422008-E23, stmd:evidence-41422008-E24, stmd:evidence-41422008-E25, stmd:evidence-41422008-E26, stmd:evidence-41422008-E27, stmd:evidence-41422008-E28, stmd:evidence-41422008-E29, stmd:evidence-41422008-E30, stmd:evidence-41422008-E31, stmd:evidence-41422008-E32, stmd:evidence-41422008-E33, stmd:evidence-41422008-E34, stmd:evidence-41422008-E35 .
stmd:evidence-41422008-E01 a stm:EvidenceItem ; stm:field stmd:field-E01 ; stm:status "present" ; stm:location "Methods, Derivation of the new prompts and their performance analysis; Table 1" ; stm:quote "The metrics included: (1) sensitivity, (2) specificity, (3) accuracy, (4) balanced accuracy, (5) positive predictive value, (6) negative predictive value, (7) F1 score, (8) false negative rate, (9) proportion missed, (10) false positive rate, 11) Matthews correlation coefficient" .
stmd:evidence-41422008-E02 a stm:EvidenceItem ; stm:field stmd:field-E02 ; stm:status "present" ; stm:location "Methods, Underlying material: description of the scoping review" ; stm:quote "The database search yielded 15 306 unique results, the abstracts of which were screened by two blinded researchers, with a third reviewer resolving any conflicts, ultimately resulting in 188 inclusions." .
stmd:evidence-41422008-E03 a stm:EvidenceItem ; stm:field stmd:field-E03 ; stm:status "present" ; stm:location "Results, Part 2: Performance of the rephrased inclusion and exclusion criteria" ; stm:quote "Given the highly imbalanced nature of the dataset (imbalance ratio, i.e. number of excluded abstracts divided by the number of included abstracts, at 21.709), the accuracy of the prompts differed" .
stmd:evidence-41422008-E04 a stm:EvidenceItem ; stm:field stmd:field-E04 ; stm:status "present" ; stm:location "Results, Part 2: Performance of the rephrased inclusion and exclusion criteria; Table 1" ; stm:quote "Under the hypothesis that all abstracts evaluated as positive require human review, the narrow prompt provided the highest workload savings (0.825)." .
stmd:evidence-41422008-E05 a stm:EvidenceItem ; stm:field stmd:field-E05 ; stm:status "present" ; stm:location "Discussion" ; stm:quote "A possible screening mode might be to proceed with solo-screening on those abstracts that were included when combining the decisions, e.g., of the narrow and wide prompt and apply the gold-standard screening of two reviewers on those abstracts that resulted in differing decisions" .
stmd:evidence-41422008-E06 a stm:EvidenceItem ; stm:field stmd:field-E06 ; stm:status "present" ; stm:location "Methods, Derivation of the new prompts and their performance analysis; Discussion" ; stm:quote "We combined ChatGPT’s decisions from each prompt using two approaches: (1) conflicts between the prompts were left undecided to be potentially resolved by a human researcher, or (2) conflicts were resolved through majority voting." .
stmd:evidence-41422008-E07 a stm:EvidenceItem ; stm:field stmd:field-E07 ; stm:status "present" ; stm:location "Results, Part 1: Population; Results, Part 1: Context" ; stm:quote "In contrast, some abstracts were falsely excluded because they referenced broad categories of healthcare providers, such as “medical doctors” and “palliative care providers”." .
stmd:evidence-41422008-E08a a stm:EvidenceItem ; stm:field stmd:field-E08a ; stm:status "present" ; stm:location "Methods, In-depth analysis of ChatGPT’s responses and the gold standard error rate" ; stm:quote "The categories were devised a priori from the scoping review’s exclusion criteria and included: no digital tool, no interaction between healthcare professionals, interaction between healthcare professionals with the same background and/or same organization" .
stmd:evidence-41422008-E08b a stm:EvidenceItem ; stm:field stmd:field-E08b ; stm:status "present" ; stm:location "Results, Part 1: Exclusion criteria" ; stm:quote "ChatGPT correctly detected the presence or absence of the exclusion criteria “students/education” in over 98% of abstracts." .
stmd:evidence-41422008-E08c a stm:EvidenceItem ; stm:field stmd:field-E08c ; stm:status "partial" ; stm:location "Methods, Underlying material: description of the scoping review" ; stm:quote "To capture all available scientific literature on this topic, all types of primary research approach and study design, including meta-analysis from any healthcare setting and geographic location, published in English, French, German, Portuguese, or Spanish were included in the study." .
stmd:evidence-41422008-E09 a stm:EvidenceItem ; stm:field stmd:field-E09 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41422008-E10 a stm:EvidenceItem ; stm:field stmd:field-E10 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41422008-E11 a stm:EvidenceItem ; stm:field stmd:field-E11 ; stm:status "present" ; stm:location "Methods, In-depth analysis of ChatGPT’s responses and the gold standard error rate" ; stm:quote "ChatGPT 4.0 screened the abstracts twice, producing slightly different results across the two rounds (interrater-reliability (Cohen’s kappa): 0.76, standard error: 0.01, 95% confidence interval: 0.75–0.78)." .
stmd:evidence-41422008-E12 a stm:EvidenceItem ; stm:field stmd:field-E12 ; stm:status "partial" ; stm:location "Discussion" ; stm:quote "Regardless of the promising results in this study, it needs to be emphasized that human oversight is – at the current point in time – still paramount." .
stmd:evidence-41422008-E13 a stm:EvidenceItem ; stm:field stmd:field-E13 ; stm:status "present" ; stm:location "Limitations; Discussion; Conclusion" ; stm:quote "First, our results are based on a single scoping review, thus additional research is required to explore the applicability of the results to other topics and disciplines." .
stmd:evidence-41422008-E14 a stm:EvidenceItem ; stm:field stmd:field-E14 ; stm:status "partial" ; stm:location "Fig. 2; Table 2; Supplementary Information statement; Data availability" ; stm:quote "Supplementary Information The online version contains supplementary material available at 10.1186/s12913-025-13901-4." .
stmd:evidence-41422008-E15 a stm:EvidenceItem ; stm:field stmd:field-E15 ; stm:status "present" ; stm:location "Methods, Underlying material: description of the scoping review" ; stm:quote "ChatGPT was chosen due to its widespread use in various domains and strong performance across tasks [ 8 , 32 , 33 ]." .
stmd:evidence-41422008-E16 a stm:EvidenceItem ; stm:field stmd:field-E16 ; stm:status "present" ; stm:location "Methods, Underlying material: description of the scoping review" ; stm:quote "These screening results are defined as the gold standard and “correct” decisions for comparing the performance of humans versus AI (Fig. 1 )." .
stmd:evidence-41422008-E17 a stm:EvidenceItem ; stm:field stmd:field-E17 ; stm:status "present" ; stm:location "Methods, Derivation of the new prompts and their performance analysis" ; stm:quote "We did not enforce a word limit and set the temperature – a parameter that controls the randomness of the response – to 0.7." .
stmd:evidence-41422008-E18 a stm:EvidenceItem ; stm:field stmd:field-E18 ; stm:status "present" ; stm:location "Fig. 2, Prompt used to elicit ChatGPT’s decisions and reasoning; Table 2, Refined criteria based on the in-depth analysis" ; stm:quote "A specific digital tool designed for interaction (i.e., communication, cooperation, coordination, and collaboration) among the target population is explicitly mentioned in the abstract ." .
stmd:evidence-41422008-E19 a stm:EvidenceItem ; stm:field stmd:field-E19 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41422008-E20 a stm:EvidenceItem ; stm:field stmd:field-E20 ; stm:status "present" ; stm:location "Methods, Underlying material: description of the scoping review; Table 2" ; stm:quote "We included a manuscript if it featured a digital tool facilitating interaction between a minimum of two healthcare workers (1) from different professional backgrounds, or (2) with the same background but working in different organizations." .
stmd:evidence-41422008-E21 a stm:EvidenceItem ; stm:field stmd:field-E21 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41422008-E22 a stm:EvidenceItem ; stm:field stmd:field-E22 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41422008-E23 a stm:EvidenceItem ; stm:field stmd:field-E23 ; stm:status "present" ; stm:location "Methods, In-depth analysis of ChatGPT’s responses and the gold standard error rate; Results, Part 1" ; stm:quote "We randomly sampled 10% of all correctly classified (included and excluded) abstracts and qualitatively evaluated the correctness of the explanations." .
stmd:evidence-41422008-E24 a stm:EvidenceItem ; stm:field stmd:field-E24 ; stm:status "present" ; stm:location "Methods, Derivation of the new prompts and their performance analysis; Results, Part 2" ; stm:quote "Based on the thematic analysis above, we reformulated the original inclusion and exclusion criteria in three refined prompts, using the “Population-Concept-Context” (PCC) scheme suggested by the Joanna Briggs Institute (Table 1 ) [ 30 ]." .
stmd:evidence-41422008-E25 a stm:EvidenceItem ; stm:field stmd:field-E25 ; stm:status "present" ; stm:location "Methods, Underlying material: description of the scoping review; Methods, Derivation of the new prompts" ; stm:quote "The protocol detailing the methodology is published elsewhere [ 31 ]." .
stmd:evidence-41422008-E26 a stm:EvidenceItem ; stm:field stmd:field-E26 ; stm:status "partial" ; stm:location "Limitations" ; stm:quote "Additionally, since ChatGPT is not open source, its training and model data, including model biases, remain undisclosed [ 24 , 42 ]." .
stmd:evidence-41422008-E27 a stm:EvidenceItem ; stm:field stmd:field-E27 ; stm:status "partial" ; stm:location "Methods, Underlying material: description of the scoping review; Methods, Derivation of the new prompts" ; stm:quote "In order to do so, we retrospectively trained ChatGPT 4.0 in a follow-up study on a subset of 100 abstracts of this scoping review [ 17 ]." .
stmd:evidence-41422008-E28 a stm:EvidenceItem ; stm:field stmd:field-E28 ; stm:status "partial" ; stm:location "Methods, Derivation of the new prompts and their performance analysis" ; stm:quote "In order to evaluate the performance of these refined prompts, we constructed a subset of abstracts comprising 25% of each category – 2465 for TN, 149 for TP, 20 for FN, 1193 for FP – and obtained ChatGPT 4.0’s decisions." .
stmd:evidence-41422008-E29 a stm:EvidenceItem ; stm:field stmd:field-E29 ; stm:status "present" ; stm:location "Methods, In-depth analysis of ChatGPT’s responses and the gold standard error rate; Results, Part 1; Supplementary appendix 1" ; stm:quote "We inductively analysed 113 false positives (2% of FP) and all 80 false negatives (100% of FN), identifying common error patterns and the underlying assumptions that led to misclassification." .
stmd:evidence-41422008-E30 a stm:EvidenceItem ; stm:field stmd:field-E30 ; stm:status "present" ; stm:location "Methods, Derivation of the new prompts and their performance analysis" ; stm:quote "The responses were gathered via an application programming interface in Excel (Microsoft Corporation), using version 6.9 of an Excel macro (ListenData, 2023) and the ‘AIAssistant’ function, which elicited responses from ChatGPT without recalling prior conversations." .
stmd:evidence-41422008-E31 a stm:EvidenceItem ; stm:field stmd:field-E31 ; stm:status "present" ; stm:location "Limitations" ; stm:quote "As large language models – such as the one underlying ChatGPT – continue to evolve, our findings reflect ChatGPT’s performance at the time of the study and may not generalize to future iterations." .
stmd:evidence-41422008-E32 a stm:EvidenceItem ; stm:field stmd:field-E32 ; stm:status "present" ; stm:location "Results, Part 2; Results, Part 1: Population and Concept; Supplementary appendix 1" ; stm:quote "When considering only the articles included after the full text screening, the number of false exclusions ranged from three (NW, NB, NBW) to twelve (N)." .
stmd:evidence-41422008-E33 a stm:EvidenceItem ; stm:field stmd:field-E33 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41422008-E34 a stm:EvidenceItem ; stm:field stmd:field-E34 ; stm:status "partial" ; stm:location "Methods, In-depth analysis of ChatGPT’s responses and the gold standard error rate; Supplementary appendix 2 and appendix 3" ; stm:quote "(interrater-reliability (Cohen’s kappa): 0.76, standard error: 0.01, 95% confidence interval: 0.75–0.78)" .
stmd:evidence-41422008-E35 a stm:EvidenceItem ; stm:field stmd:field-E35 ; stm:status "absent" ; stm:location "not found" .

stmd:study-41626916 a stm:Study ; stm:pmid "41626916" ; dcterms:title "Validation of large language models (Llama 3 and ChatGPT-4o mini) for title and abstract screening in biomedical systematic reviews" ; dcterms:date "2025" ; stm:selectionRoute "sampled" ; stm:pmcid "PMC12623132" ; stm:doi "10.1017/rsm.2025.15" .
stmd:record-41626916 a stm:EvaluationRecord ; stm:aboutStudy stmd:study-41626916 ; stm:extractedOn "2026-09-11"^^xsd:date ; stm:extractedBy "claude-code-evidence-extractor" ;
  stm:hasEvidence stmd:evidence-41626916-E01, stmd:evidence-41626916-E02, stmd:evidence-41626916-E03, stmd:evidence-41626916-E04, stmd:evidence-41626916-E05, stmd:evidence-41626916-E06, stmd:evidence-41626916-E07, stmd:evidence-41626916-E08a, stmd:evidence-41626916-E08b, stmd:evidence-41626916-E08c, stmd:evidence-41626916-E09, stmd:evidence-41626916-E10, stmd:evidence-41626916-E11, stmd:evidence-41626916-E12, stmd:evidence-41626916-E13, stmd:evidence-41626916-E14, stmd:evidence-41626916-E15, stmd:evidence-41626916-E16, stmd:evidence-41626916-E17, stmd:evidence-41626916-E18, stmd:evidence-41626916-E19, stmd:evidence-41626916-E20, stmd:evidence-41626916-E21, stmd:evidence-41626916-E22, stmd:evidence-41626916-E23, stmd:evidence-41626916-E24, stmd:evidence-41626916-E25, stmd:evidence-41626916-E26, stmd:evidence-41626916-E27, stmd:evidence-41626916-E28, stmd:evidence-41626916-E29, stmd:evidence-41626916-E30, stmd:evidence-41626916-E31, stmd:evidence-41626916-E32, stmd:evidence-41626916-E33, stmd:evidence-41626916-E34, stmd:evidence-41626916-E35 .
stmd:evidence-41626916-E01 a stm:EvidenceItem ; stm:field stmd:field-E01 ; stm:status "present" ; stm:location "Methods, 2.3 Statistical analysis; Tables 2 and 3" ; stm:quote "Sensitivity, specificity, positive predictive value (PPV), negative predictive value, and likelihood ratios were calculated for each AI tool compared with the human gold standard." .
stmd:evidence-41626916-E02 a stm:EvidenceItem ; stm:field stmd:field-E02 ; stm:status "present" ; stm:location "Methods, 2 Methods; Results, 3" ; stm:quote "The articles included in this study were those identified in a prior systematic review investigating the risk factors specific to postmenopausal women associated with the incidence of cardiovascular morbidity and mortality (PROSPERO reference: CRD42022323101)." .
stmd:evidence-41626916-E03 a stm:EvidenceItem ; stm:field stmd:field-E03 ; stm:status "present" ; stm:location "Discussion, 4" ; stm:quote "However, the PPV is moderate, ranging from 42.6% to 44.3%, due to the low prevalence of relevant articles (8.1%)." .
stmd:evidence-41626916-E04 a stm:EvidenceItem ; stm:field stmd:field-E04 ; stm:status "partial" ; stm:location "Discussion, 4" ; stm:quote "In this study, Llama 3 (LLA_2) identified 140 articles for full review compared with 84 manually selected, with 62 overlaps." .
stmd:evidence-41626916-E05 a stm:EvidenceItem ; stm:field stmd:field-E05 ; stm:status "present" ; stm:location "Discussion, 4; Conclusion, 5" ; stm:quote "Although AI has shown efficacy, human intervention remains necessary to validate and verify exclusion and inclusion decisions, potentially limiting time savings in practical settings." .
stmd:evidence-41626916-E06 a stm:EvidenceItem ; stm:field stmd:field-E06 ; stm:status "partial" ; stm:location "Discussion, 4" ; stm:quote "It is recommended to use AI to exclude irrelevant articles, with additional human review of AI-included articles to ensure a more accurate full-text evaluation." .
stmd:evidence-41626916-E07 a stm:EvidenceItem ; stm:field stmd:field-E07 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41626916-E08a a stm:EvidenceItem ; stm:field stmd:field-E08a ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41626916-E08b a stm:EvidenceItem ; stm:field stmd:field-E08b ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41626916-E08c a stm:EvidenceItem ; stm:field stmd:field-E08c ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41626916-E09 a stm:EvidenceItem ; stm:field stmd:field-E09 ; stm:status "partial" ; stm:location "Discussion, 4" ; stm:quote "Probability coefficients according to Evidence-Based Medicine 24 are used in decision-making and indicate that changes from pre-test to post-test probability can be very important, important, moderate, small, or of no clinical significance." .
stmd:evidence-41626916-E10 a stm:EvidenceItem ; stm:field stmd:field-E10 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41626916-E11 a stm:EvidenceItem ; stm:field stmd:field-E11 ; stm:status "present" ; stm:location "Discussion, 4" ; stm:quote "In the context of this study, the false negative rate (complement of sensitivity) indicates the articles that the AI might miss, potentially leading to the loss of important studies." .
stmd:evidence-41626916-E12 a stm:EvidenceItem ; stm:field stmd:field-E12 ; stm:status "partial" ; stm:location "Discussion, 4" ; stm:quote "These limitations highlight the importance of using AI as a complementary tool rather than a complete replacement for manual review in systematic reviews." .
stmd:evidence-41626916-E13 a stm:EvidenceItem ; stm:field stmd:field-E13 ; stm:status "present" ; stm:location "Discussion, 4; Conclusion, 5" ; stm:quote "These results emphasize the need for continued research and adaptation of these tools, adjusting selection criteria to address the particularities of other disciplines, and validating their performance before widespread adoption." .
stmd:evidence-41626916-E14 a stm:EvidenceItem ; stm:field stmd:field-E14 ; stm:status "present" ; stm:location "Discussion, 4; Supplementary Material 3; Data availability statement" ; stm:quote "Our study expands upon this prior work by explicitly reporting the optimized prompts and configurations used, allowing researchers with programming knowledge to easily replicate and adapt these methods." .
stmd:evidence-41626916-E15 a stm:EvidenceItem ; stm:field stmd:field-E15 ; stm:status "present" ; stm:location "Methods, 2.1 Llama 3; Methods, 2.2 ChatGPT-4o mini" ; stm:quote "Llama 3 was selected due to its completely free access through Groq, making it a viable alternative for researchers with limited budgets who require an advanced LLM without financial constraints." .
stmd:evidence-41626916-E16 a stm:EvidenceItem ; stm:field stmd:field-E16 ; stm:status "present" ; stm:location "Methods, 2 Methods" ; stm:quote "The reference standard was the manual review: two human reviewers independently assessed titles and abstracts using Rayyan between November 22, 2022, and January 23, 2023, and a third reviewer resolved discrepancies." .
stmd:evidence-41626916-E17 a stm:EvidenceItem ; stm:field stmd:field-E17 ; stm:status "present" ; stm:location "Methods, 2.2 ChatGPT-4o mini and following; Table 1" ; stm:quote "The key variation between the configurations was the temperature setting, which was adjusted to 0, 0.5, and 1." .
stmd:evidence-41626916-E18 a stm:EvidenceItem ; stm:field stmd:field-E18 ; stm:status "present" ; stm:location "Supplement: Supplementary Material 3, System prompt and user prompt, in https://static.cambridge.org/content/id/urn%3Acambridge.org%3Aid%3Aarticle%3AS1759287925000158/resource/name/S1759287925000158sup001.zip" ; stm:quote "Respond with exactly one word: 'true' if the statement is accurate, or 'false' if it is inaccurate or lacks sufficient evidence." .
stmd:evidence-41626916-E19 a stm:EvidenceItem ; stm:field stmd:field-E19 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41626916-E20 a stm:EvidenceItem ; stm:field stmd:field-E20 ; stm:status "present" ; stm:location "Methods, 2 Methods and configuration section; Supplementary Material 2 and 3" ; stm:quote "The system and user prompts are detailed in Supplementary Material 3 and were based on the eligibility criteria of the systematic review." .
stmd:evidence-41626916-E21 a stm:EvidenceItem ; stm:field stmd:field-E21 ; stm:status "partial" ; stm:location "Supplement: Supplementary Material 3, user prompt, in https://static.cambridge.org/content/id/urn%3Acambridge.org%3Aid%3Aarticle%3AS1759287925000158/resource/name/S1759287925000158sup001.zip" ; stm:quote "If any information is unclear or not explicitly stated, assume the criterion is met." .
