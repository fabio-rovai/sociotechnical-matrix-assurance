stmd:study-41626985 a stm:Study ; stm:pmid "41626985" ; dcterms:title "Optimal large language models to screen citations for systematic reviews" ; dcterms:date "2025" ; stm:selectionRoute "sampled" ; stm:pmcid "PMC12657656" ; stm:doi "10.1017/rsm.2025.10014" .
stmd:record-41626985 a stm:EvaluationRecord ; stm:aboutStudy stmd:study-41626985 ; stm:extractedOn "2026-09-11"^^xsd:date ; stm:extractedBy "evidence-extractor-agent" ;
  stm:hasEvidence stmd:evidence-41626985-E01, stmd:evidence-41626985-E02, stmd:evidence-41626985-E03, stmd:evidence-41626985-E04, stmd:evidence-41626985-E05, stmd:evidence-41626985-E06, stmd:evidence-41626985-E07, stmd:evidence-41626985-E08a, stmd:evidence-41626985-E08b, stmd:evidence-41626985-E08c, stmd:evidence-41626985-E09, stmd:evidence-41626985-E10, stmd:evidence-41626985-E11, stmd:evidence-41626985-E12, stmd:evidence-41626985-E13, stmd:evidence-41626985-E14, stmd:evidence-41626985-E15, stmd:evidence-41626985-E16, stmd:evidence-41626985-E17, stmd:evidence-41626985-E18, stmd:evidence-41626985-E19, stmd:evidence-41626985-E20, stmd:evidence-41626985-E21, stmd:evidence-41626985-E22, stmd:evidence-41626985-E23, stmd:evidence-41626985-E24, stmd:evidence-41626985-E25, stmd:evidence-41626985-E26, stmd:evidence-41626985-E27, stmd:evidence-41626985-E28, stmd:evidence-41626985-E29, stmd:evidence-41626985-E30, stmd:evidence-41626985-E31, stmd:evidence-41626985-E32, stmd:evidence-41626985-E33, stmd:evidence-41626985-E34, stmd:evidence-41626985-E35 .
stmd:evidence-41626985-E01 a stm:EvidenceItem ; stm:field stmd:field-E01 ; stm:status "present" ; stm:location "Methods, Performance measures" ; stm:quote "Accuracy metrics: sensitivity and specificity were calculated based on the number of references identified as “relevant” by each LLM and the number of references identified as “irrelevant” by each LLM." .
stmd:evidence-41626985-E02 a stm:EvidenceItem ; stm:field stmd:field-E02 ; stm:status "present" ; stm:location "Results, Conventional citation screening" ; stm:quote "The manual citation screening process, based on titles and abstracts, selected 112 of 5,634 publications (2.0%) on CQ1, 17 of 3,418 (0.5%) on CQ2, 14 of 1,038 (1.3%) on CQ3, 70 of 4,326 (1.6%) on CQ4, and 39 of 2,253 (1.7%) on CQ5." .
stmd:evidence-41626985-E03 a stm:EvidenceItem ; stm:field stmd:field-E03 ; stm:status "present" ; stm:location "Results, Conventional citation screening" ; stm:quote "Subsequent full-text screening selected a total of 41 publications for qualitative analysis: 8 from CQ1 (0.14%), 4 from CQ2 (0.12%), 4 from CQ3 (0.39%), 17 from CQ4 (0.39%), and 8 from CQ5 (0.36%)" .
stmd:evidence-41626985-E04 a stm:EvidenceItem ; stm:field stmd:field-E04 ; stm:status "present" ; stm:location "Results, Comparison of overall citation screening time, cost for 100 studies, and consistency across the LLMs" ; stm:quote "The overall citation screening times for 100 studies (at the 95% CI) using GPT-4o, Gemini 1.5 Pro, Claude 3.5 Sonnet, and Llama 3.3 70B were 0.93 [0.92–0.98] min, 1.53 [1.49–1.74] min, 3.25 [3.10–3.79] min, and 1.20 [1.12–1.24] min, respectively" .
stmd:evidence-41626985-E05 a stm:EvidenceItem ; stm:field stmd:field-E05 ; stm:status "partial" ; stm:location "Discussion" ; stm:quote "While LLM-assisted citation screening can serve as a de facto second reviewer preceding full-text screening, different performance scores highlight the necessity for systematic reviewers to consider their specific needs regarding accuracy versus workload reduction" .
stmd:evidence-41626985-E06 a stm:EvidenceItem ; stm:field stmd:field-E06 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41626985-E07 a stm:EvidenceItem ; stm:field stmd:field-E07 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41626985-E08a a stm:EvidenceItem ; stm:field stmd:field-E08a ; stm:status "present" ; stm:location "Methods, Statistical analysis" ; stm:quote "We used meta-analysis methods to calculate the integrated sensitivity and specificity across different CQs separately in the primary and secondary analyses" .
stmd:evidence-41626985-E08b a stm:EvidenceItem ; stm:field stmd:field-E08b ; stm:status "present" ; stm:location "Results, Figure 2 caption, and Supplement eTables 4 and 5" ; stm:quote "The individual sensitivity and specificity for each clinical question (CQ) and the integrated sensitivity values across CQs 1–5 were compared among GPT-4o, Gemini 1.5 Pro, Claude 3.5 Sonnet, and Llama 3.3 70B using confidence intervals." .
stmd:evidence-41626985-E08c a stm:EvidenceItem ; stm:field stmd:field-E08c ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41626985-E09 a stm:EvidenceItem ; stm:field stmd:field-E09 ; stm:status "present" ; stm:location "Background" ; stm:quote "As sufficient sensitivity has been defined as achieving a recall rate of at least 95%, such accuracy with minimal risk of missing relevant studies would be needed in this area." .
stmd:evidence-41626985-E10 a stm:EvidenceItem ; stm:field stmd:field-E10 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41626985-E11 a stm:EvidenceItem ; stm:field stmd:field-E11 ; stm:status "present" ; stm:location "Discussion" ; stm:quote "As some relevant studies may be missed by GPT-4o, reviewers should select appropriate LLMs based on their particular priorities, balancing the need to identify potentially relevant studies with the benefit of reducing the workload for human reviewers." .
stmd:evidence-41626985-E12 a stm:EvidenceItem ; stm:field stmd:field-E12 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41626985-E13 a stm:EvidenceItem ; stm:field stmd:field-E13 ; stm:status "partial" ; stm:location "Discussion, Limitations" ; stm:quote "First, we only used data from the J-SSCG 2024, which focuses on sepsis. This may have limited the generalizability of our findings to other fields." .
stmd:evidence-41626985-E14 a stm:EvidenceItem ; stm:field stmd:field-E14 ; stm:status "present" ; stm:location "Methods, Study design and settings" ; stm:quote "The source code for this study is publicly available in the GitHub repository" .
stmd:evidence-41626985-E15 a stm:EvidenceItem ; stm:field stmd:field-E15 ; stm:status "present" ; stm:location "Background" ; stm:quote "Recent LLMs such as GPT, Gemini, Claude, and Llama have shown promising potential for understanding and generating natural language-based responses, which may streamline the citation screening process." .
stmd:evidence-41626985-E16 a stm:EvidenceItem ; stm:field stmd:field-E16 ; stm:status "present" ; stm:location "Methods, Conventional citation screening" ; stm:quote "The screening process involved two independent reviewers who individually assessed the titles and abstracts of each study. Disagreements were resolved through discussion or, when necessary, by consulting a third neutral reviewer." .
stmd:evidence-41626985-E17 a stm:EvidenceItem ; stm:field stmd:field-E17 ; stm:status "partial" ; stm:location "Repository: https://github.com/seveneleven711thanks39/llm-assisted_citation_screening/blob/main/llama_integration.py" ; stm:quote "max_new_tokens=1024,                 temperature=0.7" .
stmd:evidence-41626985-E18 a stm:EvidenceItem ; stm:field stmd:field-E18 ; stm:status "present" ; stm:location "Methods, LLMs" ; stm:quote "You are conducting a systematic review and meta-analysis, focusing on a specific area of medical research. Your task is to evaluate research studies and determine whether they should be included in your review." .
stmd:evidence-41626985-E19 a stm:EvidenceItem ; stm:field stmd:field-E19 ; stm:status "partial" ; stm:location "Repository: https://github.com/seveneleven711thanks39/llm-assisted_citation_screening/blob/main/screening_text_generator.py" ; stm:quote "When judging each domain, if there is uncertainty in the decision due to a lack of adequate information, please answer with include in order to minimize the possibility of falsely excluding potentially relevant literature." .
stmd:evidence-41626985-E20 a stm:EvidenceItem ; stm:field stmd:field-E20 ; stm:status "present" ; stm:location "Methods, LLMs, and Table 1" ; stm:quote "For each query, we strictly adhered to the same phrases outlined in the framework of the CQs formulated by the J-SSCG 2024 members for conventional citation screening" .
stmd:evidence-41626985-E21 a stm:EvidenceItem ; stm:field stmd:field-E21 ; stm:status "present" ; stm:location "Methods, Statistical analysis" ; stm:quote "To maximize sensitivity, we aggregated the individual decisions of each LLM and counted the number of publications identified as “relevant” by any of them." .
stmd:evidence-41626985-E22 a stm:EvidenceItem ; stm:field stmd:field-E22 ; stm:status "present" ; stm:location "Discussion, Limitations" ; stm:quote "Fifth, the potential risk of cross-contamination between LLMs and the training data used by model developers remains a concern, particularly regarding the J-SSCG 2024 dataset." .
stmd:evidence-41626985-E23 a stm:EvidenceItem ; stm:field stmd:field-E23 ; stm:status "partial" ; stm:location "Methods, LLMs" ; stm:quote "The screening process was repeated in triplicate to ensure reproducibility. In the replicate process, the exact same prompt, same data, and same conditions were used each time." .
stmd:evidence-41626985-E24 a stm:EvidenceItem ; stm:field stmd:field-E24 ; stm:status "present" ; stm:location "Results, Comparison of overall citation screening time, cost for 100 studies, and consistency across the LLMs" ; stm:quote "The consistency for LLM-assisted citation screening (at the 95% CI) using GPT-4o, Gemini 1.5 Pro, Claude 3.5 Sonnet, and Llama 3.3 70B were 98.9% [95.9–99.2], 97.8% [96.6–98.7], 95.9% [95.6–96.6], and 98.0% [97.0–98.5], respectively" .
stmd:evidence-41626985-E25 a stm:EvidenceItem ; stm:field stmd:field-E25 ; stm:status "present" ; stm:location "Methods, Clinical questions in the J-SSCG" ; stm:quote "Extensive literature searches were conducted across several databases, including CENTRAL, PubMed, and Ichushi-Web." .
stmd:evidence-41626985-E26 a stm:EvidenceItem ; stm:field stmd:field-E26 ; stm:status "present" ; stm:location "Discussion" ; stm:quote "In contrast, closed-source commercial models present notable challenges, including limited transparency about their training data and the potential for perverse incentives that could result in misleading claims about their capabilities." .
stmd:evidence-41626985-E27 a stm:EvidenceItem ; stm:field stmd:field-E27 ; stm:status "partial" ; stm:location "Methods, LLMs" ; stm:quote "The LLM-assisted citation screening with GPT-4o, Gemini 1.5 Pro, and Claude 3.5 Sonnet was conducted between June 26 and July 18, 2024, while the screening with Llama 3.3 70B was performed between January 24 and 26, 2025." .
stmd:evidence-41626985-E28 a stm:EvidenceItem ; stm:field stmd:field-E28 ; stm:status "present" ; stm:location "Methods, LLMs" ; stm:quote "After importing the dataset from the citation management tool following the conventional method, we connected it to the application programming interface (API) of each LLM using Pandas version 1.0.5 in Python version 3.9.0." .
stmd:evidence-41626985-E29 a stm:EvidenceItem ; stm:field stmd:field-E29 ; stm:status "partial" ; stm:location "Results, Accuracy of the LLM-assisted citation screening for literature review, and Supplement eTables 2 and 3" ; stm:quote "The number of true-positive, true-negative, false-positive, and false-negative results are listed in Figures 2 and 3" .
stmd:evidence-41626985-E30 a stm:EvidenceItem ; stm:field stmd:field-E30 ; stm:status "present" ; stm:location "Methods, LLMs" ; stm:quote "We performed the citation screening using a 14-inch MacBook Pro (2021) equipped with the Apple M1 Max chip and 32 GB of RAM." .
stmd:evidence-41626985-E31 a stm:EvidenceItem ; stm:field stmd:field-E31 ; stm:status "present" ; stm:location "Discussion, Limitations" ; stm:quote "Second, our metrics for assessing accuracy relied on conventional screening methods, which can vary between reviewers. Noisy labels due to variable input from human raters can influence the performance of machine-aided labeling tests." .
stmd:evidence-41626985-E32 a stm:EvidenceItem ; stm:field stmd:field-E32 ; stm:status "present" ; stm:location "Results, Accuracy of the LLM-assisted citation screening for literature review, and Supplement eTable 5" ; stm:quote "GPT-4o and Llama 3.3 70B exhibited marked variability in sensitivity and consistent specificity, whereas Gemini 1.5 Pro and Claude 3.5 Sonnet demonstrated consistent sensitivity but notable variability in specificity." .
stmd:evidence-41626985-E33 a stm:EvidenceItem ; stm:field stmd:field-E33 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-41626985-E34 a stm:EvidenceItem ; stm:field stmd:field-E34 ; stm:status "present" ; stm:location "Methods, Statistical analysis" ; stm:quote "we counted the citations they correctly identified as “relevant” and calculated the sensitivity and specificity for each with a 95% confidence interval (CI)" .
stmd:evidence-41626985-E35 a stm:EvidenceItem ; stm:field stmd:field-E35 ; stm:status "partial" ; stm:location "Results, Comparison of overall citation screening time, cost for 100 studies, and consistency across the LLMs" ; stm:quote "Additionally, the overall citation screening costs for 100 studies using GPT-4o, Gemini 1.5 Pro, Claude 3.5 Sonnet, and Llama 3.3 70B (at the 95% CI) were $0.40 [0.37–0.46], $0.28 [0.27–0.38], $0.39 [0.35–0.42], and $0 [0–0], respectively" .

stmd:study-42059529 a stm:Study ; stm:pmid "42059529" ; dcterms:title "Novel Abstract Screening Algorithm Using Delphi-Inspired Large Language Model Consensus for Systematic Reviews in Psychiatry" ; dcterms:date "2026" ; stm:selectionRoute "sampled" ; stm:pmcid "PMC13133002" ; stm:doi "10.1177/07067437261445767" .
stmd:record-42059529 a stm:EvaluationRecord ; stm:aboutStudy stmd:study-42059529 ; stm:extractedOn "2026-09-11"^^xsd:date ; stm:extractedBy "evidence-extractor-agent" ;
  stm:hasEvidence stmd:evidence-42059529-E01, stmd:evidence-42059529-E02, stmd:evidence-42059529-E03, stmd:evidence-42059529-E04, stmd:evidence-42059529-E05, stmd:evidence-42059529-E06, stmd:evidence-42059529-E07, stmd:evidence-42059529-E08a, stmd:evidence-42059529-E08b, stmd:evidence-42059529-E08c, stmd:evidence-42059529-E09, stmd:evidence-42059529-E10, stmd:evidence-42059529-E11, stmd:evidence-42059529-E12, stmd:evidence-42059529-E13, stmd:evidence-42059529-E14, stmd:evidence-42059529-E15, stmd:evidence-42059529-E16, stmd:evidence-42059529-E17, stmd:evidence-42059529-E18, stmd:evidence-42059529-E19, stmd:evidence-42059529-E20, stmd:evidence-42059529-E21, stmd:evidence-42059529-E22, stmd:evidence-42059529-E23, stmd:evidence-42059529-E24, stmd:evidence-42059529-E25, stmd:evidence-42059529-E26, stmd:evidence-42059529-E27, stmd:evidence-42059529-E28, stmd:evidence-42059529-E29, stmd:evidence-42059529-E30, stmd:evidence-42059529-E31, stmd:evidence-42059529-E32, stmd:evidence-42059529-E33, stmd:evidence-42059529-E34, stmd:evidence-42059529-E35 .
stmd:evidence-42059529-E01 a stm:EvidenceItem ; stm:field stmd:field-E01 ; stm:status "present" ; stm:location "Methods, Statistical Analysis" ; stm:quote "Performance of the various non-LLM, single-LLM, and LLM–Delphi workflows was reported with standard metrics, including precision, recall, descriptive counts of positive and negative classifications, as well as the Work Saved over Sampling at Recall = 95% metric (WSS@95%)." .
stmd:evidence-42059529-E02 a stm:EvidenceItem ; stm:field stmd:field-E02 ; stm:status "present" ; stm:location "Methods, Datasets" ; stm:quote "After removing 10 duplicates and 10 random seed example abstracts, 4,745 remained for validation. In this dataset, 1,660 abstracts (35%) were labelled relevant by the authors for full-text review." .
stmd:evidence-42059529-E03 a stm:EvidenceItem ; stm:field stmd:field-E03 ; stm:status "present" ; stm:location "Methods, Datasets" ; stm:quote "The first was a Cochrane review from Storebø et al. 22 on attention-deficit hyperactivity disorder (ADHD) treatment from the 2019 CLEF-TAR competition, 23 yielding a dataset of 2,901 abstracts, of which 283 were relevant (10%)." .
stmd:evidence-42059529-E04 a stm:EvidenceItem ; stm:field stmd:field-E04 ; stm:status "present" ; stm:location "Results, Primary validation dataset" ; stm:quote "These metrics translate to a further 38.1% reduction in manual screening compared to unaided sequential evaluation, at the same benchmark of 95% recall (i.e., WSS@95%)." .
stmd:evidence-42059529-E05 a stm:EvidenceItem ; stm:field stmd:field-E05 ; stm:status "present" ; stm:location "Abstract, Background, and Discussion" ; stm:quote "Large language models (LLMs) may reduce the burden associated with performing systematic reviews by prescreening abstracts from a literature search for eligibility for inclusion in full-text review." .
stmd:evidence-42059529-E06 a stm:EvidenceItem ; stm:field stmd:field-E06 ; stm:status "partial" ; stm:location "Methods, Abstract Filtering Workflow Description" ; stm:quote "A limited safety-net mechanism vetoes any LLM- or probability-threshold-based decisions that markedly contradict the embedding-based similarity to the eligibility criteria in order to reduce hallucinations and random errors." .
stmd:evidence-42059529-E07 a stm:EvidenceItem ; stm:field stmd:field-E07 ; stm:status "present" ; stm:location "Discussion" ; stm:quote "The misinterpretation of abstracts with negative findings (which may lack typical numeric cues) as narrative reviews or commentaries is also concerning, as this will exacerbate publication bias if these negative results systematically fail to pass through automated screening algorithms." .
stmd:evidence-42059529-E08a a stm:EvidenceItem ; stm:field stmd:field-E08a ; stm:status "present" ; stm:location "Methods, Datasets" ; stm:quote "For secondary validation, two additional psychiatry datasets were reconstructed from widely referenced systematic review-screening datasets, chosen due to their size and availability of abstract-stage labelling." .
stmd:evidence-42059529-E08b a stm:EvidenceItem ; stm:field stmd:field-E08b ; stm:status "present" ; stm:location "Results, Secondary validation datasets, and Supplement Appendices 6 and 7" ; stm:quote "In the two secondary validation datasets reconstructed from the reviews of Storebø et al. and van de Schoot et al., the recall metric was similar (100.0% and 96.4%), but the work saved metrics were lower (17.3% and 18.5% WSS@95%, respectively)" .
stmd:evidence-42059529-E08c a stm:EvidenceItem ; stm:field stmd:field-E08c ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-42059529-E09 a stm:EvidenceItem ; stm:field stmd:field-E09 ; stm:status "present" ; stm:location "Introduction" ; stm:quote "We hypothesized that if the workflow can capture at least 95% of the researcher-identified relevant abstracts while meaningfully reducing the number of abstracts to be screened, it could be valuable for integration into routine usage." .
stmd:evidence-42059529-E10 a stm:EvidenceItem ; stm:field stmd:field-E10 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-42059529-E11 a stm:EvidenceItem ; stm:field stmd:field-E11 ; stm:status "present" ; stm:location "Introduction" ; stm:quote "In abstract screening, hallucination can lead to misidentification of study components or overextension of details, directly causing false positives and negatives." .
stmd:evidence-42059529-E12 a stm:EvidenceItem ; stm:field stmd:field-E12 ; stm:status "partial" ; stm:location "Discussion" ; stm:quote "These active-learning tools are computationally efficient, and the human labeller helps them maintain strong anchoring to the eligibility criteria, which is an advantage against our workflow's potential for self-reinforcing LLM hallucinations in longer automated runs." .
stmd:evidence-42059529-E13 a stm:EvidenceItem ; stm:field stmd:field-E13 ; stm:status "present" ; stm:location "Conclusions, and Discussion" ; stm:quote "Our workflow is optimized for privacy-focused local deployment avoiding costly cloud-based solutions. As a preranking or prescreening step, it can save substantial time while providing excellent recall and reasoning trails." .
stmd:evidence-42059529-E14 a stm:EvidenceItem ; stm:field stmd:field-E14 ; stm:status "present" ; stm:location "Data Availability Statement, and Supplement Appendices 1 to 5" ; stm:quote "However, we provide details of the workflow logic, configurations, and LLM prompts in the methods, schematic figure, and supplements to facilitate independent reproduction." .
stmd:evidence-42059529-E15 a stm:EvidenceItem ; stm:field stmd:field-E15 ; stm:status "present" ; stm:location "Introduction" ; stm:quote "Using five LLM agents from different architectures to enrich and reassess a common prompt should minimize the detrimental impact of any one model's hallucination or training biases." .
stmd:evidence-42059529-E16 a stm:EvidenceItem ; stm:field stmd:field-E16 ; stm:status "present" ; stm:location "Methods, Datasets" ; stm:quote "The workflow was first validated using the systematic review by Parellada et al. 21 on nonsyndromic autism spectrum disorder (ASD) biomarkers, which was chosen as it published complete abstract-stage screening data in its supplements." .
stmd:evidence-42059529-E17 a stm:EvidenceItem ; stm:field stmd:field-E17 ; stm:status "present" ; stm:location "Supplement: Appendix 1, section 2 LLM escalation (https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13133002/supplementaryFiles ; https://doi.org/10.1177/07067437261445767)" ; stm:quote "To fit within the 16GB video card memory limit, 8-bit quantized versions of the 8B models, and the 4-bit (Q4_K_M) version of the 12B Gemma 3 model were used. Temperature of 0 was used for all models to minimize run-to-run variation in results ." .
stmd:evidence-42059529-E18 a stm:EvidenceItem ; stm:field stmd:field-E18 ; stm:status "present" ; stm:location "Supplement: Appendix 5, The LLM prompt used in the experiment (https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13133002/supplementaryFiles ; https://doi.org/10.1177/07067437261445767)" ; stm:quote "You are assisting with systematic review abstract screening. Please decide if the given abstract meets the eligibility criteria. Use the eligibility criteria and examples to guide your decision." .
stmd:evidence-42059529-E19 a stm:EvidenceItem ; stm:field stmd:field-E19 ; stm:status "present" ; stm:location "Supplement: Appendix 5, response schema (https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13133002/supplementaryFiles ; https://doi.org/10.1177/07067437261445767)" ; stm:quote "\"label\": \"yes\" | \"no\" | \"uncertain\"," .
stmd:evidence-42059529-E20 a stm:EvidenceItem ; stm:field stmd:field-E20 ; stm:status "present" ; stm:location "Methods, Abstract Filtering Workflow Description, and Supplement Appendices 2 to 4" ; stm:quote "The workflow begins with the manual specification ( Supplemental Appendices 2–4 ) of the eligibility criteria, their query-style paraphrases, and identifying five positive and five negative abstracts." .
stmd:evidence-42059529-E21 a stm:EvidenceItem ; stm:field stmd:field-E21 ; stm:status "present" ; stm:location "Methods, Statistical Analysis" ; stm:quote "This metric relates to the amount of unnecessary work that must be done to manually screen and exclude any false positive identification from the model's output, which is of lower priority than recall for document screening." .
stmd:evidence-42059529-E22 a stm:EvidenceItem ; stm:field stmd:field-E22 ; stm:status "absent" ; stm:location "not found" .
stmd:evidence-42059529-E23 a stm:EvidenceItem ; stm:field stmd:field-E23 ; stm:status "present" ; stm:location "Discussion" ; stm:quote "Post-hoc review revealed some hallucination errors such as LLMs overextending trivial text in the abstract." .
stmd:evidence-42059529-E24 a stm:EvidenceItem ; stm:field stmd:field-E24 ; stm:status "partial" ; stm:location "Supplement: Appendix 1, section 3 LLM prompt (https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13133002/supplementaryFiles ; https://doi.org/10.1177/07067437261445767)" ; stm:quote "The randomized selection of few-shot examples improve diversity in research methods and writing styles, which outperformed manually synthesized set of static examples." .
stmd:evidence-42059529-E25 a stm:EvidenceItem ; stm:field stmd:field-E25 ; stm:status "present" ; stm:location "Methods, Datasets" ; stm:quote "Unlike the complete ASD dataset, however, these additional datasets were reconstructed post hoc by third parties and thus could not capture the entire corpus that the original authors screened (capturing 22% and 72% of the original total records, respectively)." .
stmd:evidence-42059529-E26 a stm:EvidenceItem ; stm:field stmd:field-E26 ; stm:status "present" ; stm:location "References, items 28 to 32" ; stm:quote "mistralai/Ministral-8B-Instruct-2410 · Hugging Face [accessed 30 November 2025]." .
stmd:evidence-42059529-E27 a stm:EvidenceItem ; stm:field stmd:field-E27 ; stm:status "partial" ; stm:location "Supplement: Appendix 1, section 2 LLM escalation (https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13133002/supplementaryFiles ; https://doi.org/10.1177/07067437261445767)" ; stm:quote "To fit within the 16GB video card memory limit, 8-bit quantized versions of the 8B models, and the 4-bit (Q4_K_M) version of the 12B Gemma 3 model were used." .
stmd:evidence-42059529-E28 a stm:EvidenceItem ; stm:field stmd:field-E28 ; stm:status "present" ; stm:location "Discussion, Strengths" ; stm:quote "The models integrated into the workflow are all open-source, and the entire workflow can run on a private, local workstation with a single 16 GB GPU without relying on cloud-based solutions." .
stmd:evidence-42059529-E29 a stm:EvidenceItem ; stm:field stmd:field-E29 ; stm:status "present" ; stm:location "Results, Missed Abstracts" ; stm:quote "Examination of the Delphi records for the 50 false negatives from the ASD dataset suggested three misclassification themes. The most common reason (26/50) was the overemphasis of keywords related to genetic or metabolic biomarkers." .
stmd:evidence-42059529-E30 a stm:EvidenceItem ; stm:field stmd:field-E30 ; stm:status "present" ; stm:location "Supplement: Appendix 1, opening paragraph (https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13133002/supplementaryFiles ; https://doi.org/10.1177/07067437261445767)" ; stm:quote "The LLM-Delphi abstract screening workflow was coded in Python and was validated to run with optimal performance on single-GPU workstations (NVIDIA GeForce 5070 Ti, 5060 Ti, or 4060 Ti, 16GB VRAM, as little as 32GB system RAM)." .
stmd:evidence-42059529-E31 a stm:EvidenceItem ; stm:field stmd:field-E31 ; stm:status "present" ; stm:location "Discussion" ; stm:quote "However, since human-labelled datasets can still contain occasional labelling inconsistencies or rely on heuristics or privileged information not explicit in the abstract, expecting 100% recall may be impractical, even with the best models and workflows." .
stmd:evidence-42059529-E32 a stm:EvidenceItem ; stm:field stmd:field-E32 ; stm:status "present" ; stm:location "Results, Missed Abstracts" ; stm:quote "The two consequential false negatives 35 , 36 ultimately included among the 264 abstracts for full-text data extraction were also of this type." .
stmd:evidence-42059529-E33 a stm:EvidenceItem ; stm:field stmd:field-E33 ; stm:status "partial" ; stm:location "Introduction" ; stm:quote "We hypothesized that if the workflow can capture at least 95% of the researcher-identified relevant abstracts while meaningfully reducing the number of abstracts to be screened, it could be valuable for integration into routine usage." .
stmd:evidence-42059529-E34 a stm:EvidenceItem ; stm:field stmd:field-E34 ; stm:status "partial" ; stm:location "Methods, LLM-Delphi Comparison to Single-LLM and Non-LLM Workflows" ; stm:quote "The starting set of 10 seed examples was bootstrap resampled 100 times to establish confidence intervals, including one run with the same starting seed examples (i.e., run #100) as the LLM agent experiments." .
stmd:evidence-42059529-E35 a stm:EvidenceItem ; stm:field stmd:field-E35 ; stm:status "partial" ; stm:location "Results, Primary validation dataset" ; stm:quote "On the ASD dataset, the workflow screened all 4,745 abstracts in approximately 20 h, or 96 iterations." .

stmd:study-42286747 a stm:Study ; stm:pmid "42286747" ; dcterms:title "Using full agreement across multiple large language models for title-and-abstract screening in systematic reviews: a proof-of-concept" ; dcterms:date "2026" ; stm:selectionRoute "sampled" ; stm:pmcid "PMC13263951" ; stm:doi "10.1186/s13643-026-03228-4" .
